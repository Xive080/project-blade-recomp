+#pragma once
+
+#include <cstddef>
+#include <cstdio>
+#include <cstdint>
+
+namespace ps2x::iop
+{
+    // Destino del audio mezclado del SPU2: estereo de 16 bits intercalado a 48 kHz. Se llama desde el hilo del IOP, en
+    // lotes, con el tiempo del IOP (una muestra cada 768 ciclos de 36,864 MHz); el destino debe ser seguro entre hilos
+    // si lo consume otro. Sin destino, el SPU2 sigue avanzando (posiciones, ENDX) pero la mezcla se descarta.
+    constexpr uint32_t kSpu2SampleRate = 48000;
+    using Spu2SinkFn = void (*)(void *user, const int16_t *stereoFrames, size_t frames);
+    void setSpu2Sink(Spu2SinkFn sink, void *user);
+
+    // Traza de depuracion: con PS2X_SPU_TRACE=ruta devuelve el fichero donde se anotan las escrituras de registros del
+    // SPU2 ("W ciclo direccion antes despues"), los DMA ("D ..."), las llamadas RPC del EE ("R sid funcion bytes datos")
+    // y un resumen cada 250 ms de audio ("S ..."). Sin la variable devuelve nullptr.
+    std::FILE *spu2TraceFile();
+}
