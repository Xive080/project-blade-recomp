+    // Operando sin riesgo de desbordamiento ni subdesbordamiento en sumas y productos: cero o
+    // |x| en [2^-63, 2^63].
+    inline bool fmacOperandSafe(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        return (bits & 0x7FFFFFFFu) == 0u || (exponent >= 64u && exponent <= 190u);
+    }
+
+    // Resultado normal lejos de los limites: |r| en [2^-101, 2^127).
+    inline bool fmacResultSafe(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        return exponent >= 26u && exponent <= 253u;
+    }
+
+    inline uint32_t signOf(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        return bits >> 31;
+    }
+}
