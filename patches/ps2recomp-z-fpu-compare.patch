 #define FPU_C_UEQ_S(a, b) ((float)(a) == (float)(b) || isnan((float)(a)) || isnan((float)(b)))
-#define FPU_C_OLT_S(a, b) ((float)(a) < (float)(b))
+#define FPU_C_OLT_S(a, b) ps2_fcmp_lt((float)(a), (float)(b))
