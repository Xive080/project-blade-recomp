+int ps2xVu1Replay(const char *path)
+{
+    FILE *f = std::fopen(path, "rb");
+    if (!f)
+    {
+        std::fprintf(stderr, "[vu1replay] no se puede abrir %s\n", path);
+        return 2;
+    }
+    char magic[8];
+    uint32_t sizes[2];
+    if (std::fread(magic, 1, 8, f) != 8 || std::memcmp(magic, "VU1REC01", 8) != 0 || std::fread(sizes, sizeof(sizes), 1, f) != 1)
+    {
+        std::fprintf(stderr, "[vu1replay] formato no valido\n");
+        return 2;
+    }
+    VU1Interpreter rep(VU1Interpreter::Unit::VU1);
+    GS gs;
+    std::vector<uint8_t> code(sizes[0], 0u), data(sizes[1], 0u);
+    g_gifTap.hashing = true;
+    g_gifTap.suppress = true;
+    uint64_t calls = 0, ok = 0, bad = 0, skipped = 0;
+    const auto t0 = std::chrono::steady_clock::now();
+    for (;;)
+    {
+        uint8_t tag = 0;
+        if (std::fread(&tag, 1, 1, f) != 1)
+            break;
+        if (tag == 'C')
+        {
+            if (std::fread(code.data(), 1, code.size(), f) != code.size())
+                break;
+            continue;
+        }
+        if (tag != 'K')
+            break;
+        uint8_t kind = 0;
+        uint32_t a[4];
+        VU1State pre{}, post{};
+        uint32_t changed = 0;
+        bool good = std::fread(&kind, 1, 1, f) == 1 && std::fread(a, sizeof(a), 1, f) == 1 && std::fread(&pre, sizeof(pre), 1, f) == 1 &&
+                    std::fread(&changed, sizeof(changed), 1, f) == 1;
+        for (uint32_t i = 0; good && i < changed; ++i)
+        {
+            uint16_t idx = 0;
+            good = std::fread(&idx, sizeof(idx), 1, f) == 1 && (idx + 1u) * kRecChunk <= data.size() &&
+                   std::fread(data.data() + idx * kRecChunk, 1, kRecChunk, f) == kRecChunk;
+        }
+        uint64_t cyc = 0, dataHash = 0, gifHash = 0;
+        uint8_t clean = 0;
+        uint32_t gifCount = 0;
+        good = good && std::fread(&post, sizeof(post), 1, f) == 1 && std::fread(&cyc, sizeof(cyc), 1, f) == 1 &&
+               std::fread(&clean, 1, 1, f) == 1 && std::fread(&dataHash, sizeof(dataHash), 1, f) == 1 &&
+               std::fread(&gifHash, sizeof(gifHash), 1, f) == 1 && std::fread(&gifCount, sizeof(gifCount), 1, f) == 1;
+        if (!good)
+            break;
+        ++calls;
+        rep.state() = pre;
+        VU1Internal::prepareReplay(rep);
+        g_gifTap.hash = 1469598103934665603ull;
+        g_gifTap.count = 0;
+        const uint64_t c0 = VU1Internal::cycle(rep);
+        if (kind == 0)
+            rep.execute(code.data(), sizes[0], data.data(), sizes[1], gs, nullptr, a[0], a[1], a[2], a[3]);
+        else
+            rep.resume(code.data(), sizes[0], data.data(), sizes[1], gs, nullptr, a[1], a[2], a[3]);
+        if (!clean)
+        {
+            ++skipped;
+            continue;
+        }
+        const char *field = "";
+        const bool sameSt = sameState(rep.state(), post, field);
+        const uint64_t dCyc = VU1Internal::cycle(rep) - c0;
+        const uint64_t dh = fnvWords(data.data(), data.size());
+        if (sameSt && dCyc == cyc && dh == dataHash && g_gifTap.hash == gifHash && g_gifTap.count == gifCount)
+            ++ok;
+        else
+        {
+            if (++bad <= 5)
+                std::fprintf(stderr, "[vu1replay] DIFERENCIA en la llamada %llu (%s, arranque 0x%x): estado=%s (%s) ciclos %llu/%llu datos=%s gif=%s\n",
+                             (unsigned long long)calls, kind == 0 ? "execute" : "resume", a[0], sameSt ? "ok" : "distinto", field,
+                             (unsigned long long)dCyc, (unsigned long long)cyc, dh == dataHash ? "ok" : "distintos",
+                             (g_gifTap.hash == gifHash && g_gifTap.count == gifCount) ? "ok" : "distinto");
+        }
+    }
+    std::fclose(f);
+    const double secs = std::chrono::duration<double>(std::chrono::steady_clock::now() - t0).count();
+    std::printf("[vu1replay] %llu llamadas: %llu identicas, %llu distintas, %llu no reproducibles; %.2f s\n", (unsigned long long)calls,
+                (unsigned long long)ok, (unsigned long long)bad, (unsigned long long)skipped, secs);
+    std::fflush(stdout);
+    return bad == 0 && ok > 0 ? 0 : 1;
+}
