+#pragma once
+
+#include "runtime/gs/gs_backend.h"
+#include "runtime/gs/gs_cpu_backend.h"
+
+#include <condition_variable>
+#include <cstdint>
+#include <deque>
+#include <memory>
+#include <mutex>
+#include <thread>
+#include <vector>
+
+// Ejecuta otro backend (el de CPU) en un hilo propio. Las ordenes que no devuelven nada (primitivas, CLUT,
+// transferencias, subidas, borrados) se encolan en orden; las que leen el estado (VRAM, presentacion, bytes de una
+// transferencia local->host) esperan a que el hilo haya ejecutado todo lo encolado antes. El orden de las escrituras
+// en la VRAM es el mismo que sin hilo, asi que la imagen no cambia.
+class GSThreadedBackend final : public GSRasterBackend
+{
+public:
+    explicit GSThreadedBackend(std::unique_ptr<GSCpuBackend> inner);
+    ~GSThreadedBackend() override;
+
+    void Initialize(uint8_t *vram, uint32_t vramSize) override;
+    void Reset() override;
+
+    void Submit(const GSPrimitiveBatch &batch) override;
+    void LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut) override;
+    void BeginTransfer(const GSTransferCommand &command) override;
+    void UploadImage(const uint8_t *data, uint32_t sizeBytes) override;
+
+    void Flush() override;
+    void TextureFlush() override;
+    void Sync(GSSyncReason reason) override;
+    PresentationFrame Present(const GSPresentationRequest &request) override;
+
+    bool ClearFramebuffer(const GSContext &context, uint32_t rgba) override;
+    uint32_t ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes) override;
+
+    uint32_t ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const override;
+    void WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value) override;
+    void SnapshotVram(std::vector<uint8_t> &out) const override;
+    GSTransferSnapshot GetTransferSnapshot() const override;
+
+    // Desactivado con PS2X_GS_THREAD=0.
+    static bool EnabledByEnvironment();
+
+private:
+    enum class Op : uint8_t
+    {
+        Submit,
+        LoadClut,
+        BeginTransfer,
+        Upload,
+        TextureFlush,
+        Clear,
+        WriteVram,
+    };
+
+    struct Command
+    {
+        Op op = Op::Submit;
+        uint32_t a = 0; // Upload: desplazamiento; Clear: rgba; WriteVram: psm
+        uint32_t b = 0; // Upload: bytes; WriteVram: base
+        uint32_t c = 0, d = 0, e = 0, f = 0; // WriteVram: bw, x, y, valor
+        GSPrimitiveBatch batch{};
+        GSTex0Reg tex0{};
+        GSTexClutReg texclut{};
+        GSTransferCommand transfer{};
+    };
+
+    struct Chunk
+    {
+        std::vector<Command> commands;
+        std::vector<uint8_t> data;
+    };
+
+    Command &appendLocked(Op op);
+    void publishLocked();
+    void waitIdle() const;
+    void workerLoop();
+    void execute(const Chunk &chunk, const Command &cmd);
+
+    static constexpr size_t kPublishCommands = 256u;
+    static constexpr size_t kPublishBytes = 64u * 1024u;
+
+    std::unique_ptr<GSCpuBackend> m_inner;
+    std::vector<const GSPrimitiveBatch *> m_runScratch;
+    bool m_hasVram = false;
+
+    mutable std::mutex m_producerMutex; // chunk en curso
+    std::unique_ptr<Chunk> m_current;
+    uint64_t m_submittedChunks = 0;
+
+    mutable std::mutex m_queueMutex;
+    mutable std::condition_variable m_queueCv;
+    mutable std::condition_variable m_doneCv;
+    std::deque<std::unique_ptr<Chunk>> m_queue;
+    std::vector<std::unique_ptr<Chunk>> m_free;
+    uint64_t m_queuedChunks = 0;
+    uint64_t m_completedChunks = 0;
+    bool m_workerWaiting = false;
+    bool m_stop = false;
+    std::thread m_worker;
+};
