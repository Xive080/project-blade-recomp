+    // ---- SPU2 (modelo de voces) ----
+    namespace
+    {
+        constexpr uint32_t kSpuRamBytes = 2u * 1024u * 1024u;
+        constexpr uint32_t kSpuCoreStride = 0x400u;
+        constexpr uint64_t kSpuSampleRate = 48000u;
+        constexpr uint64_t kIopHz = 36864000u;
+        constexpr uint32_t kSamplesPerBlock = 28u;
+
+        // registro relativo al nucleo (0..0x3FF) y nucleo, o false si no es un registro de nucleo
+        bool spuCoreRegister(uint32_t address, uint32_t &core, uint32_t &reg)
+        {
+            const uint32_t offset = address - IopMemory::Spu2Base;
+            if (offset >= 2u * kSpuCoreStride)
+                return false;
+            core = offset / kSpuCoreStride;
+            reg = offset % kSpuCoreStride;
+            return true;
+        }
+    }
+
+    uint16_t IopMemory::spuReg(uint32_t address) const
+    {
+        const auto stored = m_hardware.find(address & ~3u);
+        const uint32_t word = stored != m_hardware.end() ? stored->second : 0u;
+        return static_cast<uint16_t>(word >> ((address & 2u) * 8u));
+    }
+
+    void IopMemory::spuSetReg(uint32_t address, uint16_t value) const
+    {
+        auto &word = const_cast<std::unordered_map<uint32_t, uint32_t> &>(m_hardware)[address & ~3u];
+        const uint32_t shift = (address & 2u) * 8u;
+        word = (word & ~(0xFFFFu << shift)) | (static_cast<uint32_t>(value) << shift);
+    }
+
+    void IopMemory::spuAdvance() const
+    {
+        const uint64_t now = m_cycleSource ? *m_cycleSource : 0u;
+        if (now <= m_spuLastCycle)
+            return;
+        const uint64_t elapsed = now - m_spuLastCycle;
+        m_spuLastCycle = now;
+        for (uint32_t index = 0; index < m_spuVoices.size(); ++index)
+        {
+            SpuVoice &voice = m_spuVoices[index];
+            if (!voice.active)
+                continue;
+            const uint32_t core = index / 24u;
+            const uint32_t slot = index % 24u;
+            const uint64_t pitch = std::min<uint32_t>(spuReg(Spu2Base + core * kSpuCoreStride + slot * 0x10u + 4u), 0x3FFFu);
+            // muestras * 4096 avanzadas en este intervalo
+            voice.fraction += elapsed * kSpuSampleRate * pitch / kIopHz;
+            constexpr uint64_t kBlockUnits = static_cast<uint64_t>(kSamplesPerBlock) * 4096u;
+            uint32_t guard = 0;
+            while (voice.active && voice.fraction >= kBlockUnits && guard++ < 65536u)
+            {
+                voice.fraction -= kBlockUnits;
+                const uint8_t flags = m_spuRam[(voice.nax + 1u) % kSpuRamBytes];
+                if ((flags & 0x04u) != 0u && !voice.lsaxSet)
+                    voice.lsax = voice.nax;
+                if ((flags & 0x01u) != 0u)
+                {
+                    m_spuEndx[core] |= 1u << slot;
+                    voice.nax = voice.lsax;
+                    if ((flags & 0x02u) == 0u)
+                        voice.active = false;
+                }
+                else
+                {
+                    voice.nax = (voice.nax + 16u) % kSpuRamBytes;
+                }
+            }
+            if (guard >= 65536u)
+                voice.fraction = 0u;
+        }
+    }
+
+    uint32_t IopMemory::spuOverride(uint32_t address, uint32_t stored) const
+    {
+        uint32_t core = 0u;
+        uint32_t reg = 0u;
+        if (!spuCoreRegister(address, core, reg))
+            return stored;
+        spuAdvance();
+        uint32_t result = stored;
+        for (uint32_t half = 0; half < 2u; ++half)
+        {
+            const uint32_t r = reg + half * 2u;
+            uint32_t value = (stored >> (half * 16u)) & 0xFFFFu;
+            if (r >= 0x1C0u && r < 0x1C0u + 24u * 0xCu)
+            {
+                const uint32_t slot = (r - 0x1C0u) / 0xCu;
+                const uint32_t field = (r - 0x1C0u) % 0xCu;
+                const SpuVoice &voice = m_spuVoices[core * 24u + slot];
+                if (field == 8u)
+                    value = (voice.nax >> 17u) & 0xFu;
+                else if (field == 10u)
+                    value = (voice.nax >> 1u) & 0xFFFFu;
+            }
+            else if (r < 24u * 0x10u && (r & 0xFu) == 0xAu)
+            {
+                // ENVX: la envolvente no se modela; vale 0 cuando la voz ha terminado
+                value = m_spuVoices[core * 24u + r / 0x10u].active ? 0x7FFFu : 0u;
+            }
+            else if (r == 0x340u)
+                value = m_spuEndx[core] & 0xFFFFu;
+            else if (r == 0x342u)
+                value = (m_spuEndx[core] >> 16u) & 0xFFu;
+            result = (result & ~(0xFFFFu << (half * 16u))) | (value << (half * 16u));
+        }
+        return result;
+    }
+
+    void IopMemory::spuWrite(uint32_t address, uint32_t oldValue, uint32_t value)
+    {
+        uint32_t core = 0u;
+        uint32_t reg = 0u;
+        if (!spuCoreRegister(address, core, reg))
+            return;
+        spuAdvance();
+        const uint32_t base = Spu2Base + core * kSpuCoreStride;
+        for (uint32_t half = 0; half < 2u; ++half)
+        {
+            const uint32_t r = reg + half * 2u;
+            const uint16_t now = static_cast<uint16_t>(value >> (half * 16u));
+            const uint16_t before = static_cast<uint16_t>(oldValue >> (half * 16u));
+            if (r == 0x1A0u || r == 0x1A2u || r == 0x1A4u || r == 0x1A6u)
+            {
+                // KON/KOFF actuan al escribirse; se guardan a 0 para que la escritura byte a byte no los repita
+                spuSetReg(base + r, 0u);
+                const uint32_t bits = r == 0x1A0u || r == 0x1A4u ? now : static_cast<uint32_t>(now & 0xFFu) << 16u;
+                for (uint32_t slot = 0; slot < 24u; ++slot)
+                {
+                    if ((bits & (1u << slot)) == 0u)
+                        continue;
+                    SpuVoice &voice = m_spuVoices[core * 24u + slot];
+                    if (r == 0x1A0u || r == 0x1A2u)
+                    {
+                        const uint32_t ssa = ((static_cast<uint32_t>(spuReg(base + 0x1C0u + slot * 0xCu)) & 0xFu) << 16u) |
+                                             spuReg(base + 0x1C2u + slot * 0xCu);
+                        voice.active = true;
+                        voice.nax = (ssa * 2u) % kSpuRamBytes;
+                        voice.fraction = 0u;
+                        voice.lsaxSet = false;
+                        voice.lsax = voice.nax;
+                        m_spuEndx[core] &= ~(1u << slot);
+                    }
+                    else
+                    {
+                        voice.active = false;
+                    }
+                }
+                continue;
+            }
+            if (now == before)
+                continue;
+            if (r >= 0x1C0u && r < 0x1C0u + 24u * 0xCu)
+            {
+                const uint32_t slot = (r - 0x1C0u) / 0xCu;
+                const uint32_t field = (r - 0x1C0u) % 0xCu;
+                if (field == 4u || field == 6u)
+                {
+                    SpuVoice &voice = m_spuVoices[core * 24u + slot];
+                    const uint32_t lsa = ((static_cast<uint32_t>(spuReg(base + 0x1C4u + slot * 0xCu)) & 0xFu) << 16u) |
+                                         spuReg(base + 0x1C6u + slot * 0xCu);
+                    voice.lsax = (lsa * 2u) % kSpuRamBytes;
+                    voice.lsaxSet = true;
+                }
+            }
+            else if (r == 0x340u || r == 0x342u)
+            {
+                m_spuEndx[core] = 0u;
+            }
+        }
+        if (reg == 0x1ACu)
+        {
+            // puerto de datos: escribe en TSA y avanza
+            const uint32_t tsa = ((static_cast<uint32_t>(spuReg(base + 0x1A8u)) & 0xFu) << 16u) | spuReg(base + 0x1AAu);
+            const uint16_t data = static_cast<uint16_t>(value);
+            const uint32_t byteAddress = (tsa * 2u) % kSpuRamBytes;
+            m_spuRam[byteAddress] = static_cast<uint8_t>(data);
+            m_spuRam[(byteAddress + 1u) % kSpuRamBytes] = static_cast<uint8_t>(data >> 8u);
+            const uint32_t next = (tsa + 1u) & 0xFFFFFu;
+            spuSetReg(base + 0x1A8u, static_cast<uint16_t>(next >> 16u));
+            spuSetReg(base + 0x1AAu, static_cast<uint16_t>(next));
+        }
+    }
+
+    void IopMemory::spuDmaTransfer(bool secondCore, uint32_t madr, uint32_t bytes, bool toSpu)
+    {
+        const uint32_t base = Spu2Base + (secondCore ? kSpuCoreStride : 0u);
+        const uint32_t tsa = ((static_cast<uint32_t>(spuReg(base + 0x1A8u)) & 0xFu) << 16u) | spuReg(base + 0x1AAu);
+        uint32_t spuAddress = (tsa * 2u) % kSpuRamBytes;
+        uint32_t ramAddress = physicalAddress(madr) % RamSize;
+        for (uint32_t i = 0; i < bytes; ++i)
+        {
+            if (toSpu)
+                m_spuRam[spuAddress] = m_ram[ramAddress];
+            else
+                m_ram[ramAddress] = m_spuRam[spuAddress];
+            spuAddress = (spuAddress + 1u) % kSpuRamBytes;
+            ramAddress = (ramAddress + 1u) % RamSize;
+        }
+    }
 }
