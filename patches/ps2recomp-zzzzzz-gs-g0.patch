+    void g0Dump()
+    {
+        std::lock_guard<std::mutex> lk(g_g0s.mu);
+        auto &s = g_g0s;
+        const double fr = std::max<uint64_t>(s.frames, 1);
+        std::fprintf(stderr, "[g0] ==== resumen: Present %llu..%llu (%llu Present con dibujo) ====\n",
+                     (unsigned long long)s.presentFirst, (unsigned long long)s.presentLast, (unsigned long long)s.frames);
+        std::fprintf(stderr, "[g0] primitivas totales por Present: %.0f\n", s.totPrims / fr);
+        const char *rn[3] = {"destino/z solapados", "textura solapa destino", "tramo pequeno (<4096 px)"};
+        for (int k = 0; k < 2; ++k)
+            std::fprintf(stderr, "[g0] motivo 0 (FRAME/ZBUF solapan por rangos), %s: prim/Present=%.0f px/prim=%.0f ms/Present=%.2f\n", k ? "con bloques compartidos (real)" : "sin bloques compartidos (falso)",
+                         s.r0[k].n / fr, s.r0[k].n ? (double)s.r0[k].px / s.r0[k].n : 0.0, s.r0[k].ns / 1e6 / fr);
+        for (int k = 0; k < 11; ++k)
+            if (s.cause[k].n)
+                std::fprintf(stderr, "[g0] motivo 2 (tramo pequeno) cortado por '%s': tramos/Present=%.0f prim/Present=%.0f px/prim=%.0f ms/Present=%.2f\n", kG0CauseName[k],
+                             s.causeRuns[k] / fr, s.cause[k].n / fr, (double)s.cause[k].px / s.cause[k].n, s.cause[k].ns / 1e6 / fr);
+        for (int k = 0; k < 3; ++k)
+            std::fprintf(stderr, "[g0] serie motivo '%s': prim/Present=%.0f px/prim=%.0f ms/Present=%.2f\n", rn[k], s.reason[k].n / fr,
+                         s.reason[k].n ? (double)s.reason[k].px / s.reason[k].n : 0.0, s.reason[k].ns / 1e6 / fr);
+        std::fprintf(stderr, "[g0] 'textura solapa destino' disparado por: solo FRAME=%llu solo ZBUF=%llu ambos=%llu\n",
+                     (unsigned long long)s.fTrigger, (unsigned long long)s.zTrigger, (unsigned long long)s.bothTrigger);
+        for (int c = 0; c < 8; ++c)
+            std::fprintf(stderr, "[g0] cat %d '%s': prim/Present=%.0f px(escritos)/prim=%.0f px(leidos, rect UV)/prim=%.0f ms/Present=%.2f\n", c, kG0CatName[c],
+                         s.cat[c].n / fr, s.cat[c].n ? (double)s.cat[c].px / s.cat[c].n : 0.0, s.cat[c].n ? (double)s.cat[c].rdPx / s.cat[c].n : 0.0, s.cat[c].ns / 1e6 / fr);
+        std::fprintf(stderr, "[g0] simulacion con prueba exacta de bloques: paralelo=%.0f prim/Present (%.1f Mpx/Present), serie=%.0f prim/Present (%.2f Mpx/Present), tramos paralelos=%.1f/Present\n",
+                     s.simPar / fr, s.simParPx / 1e6 / fr, s.simSer / fr, s.simSerPx / 1e6 / fr, s.simRuns / fr);
+        std::vector<std::pair<uint64_t, std::string>> v;
+        for (auto &kv : s.groups)
+            v.emplace_back(kv.second.ns, kv.first);
+        std::sort(v.rbegin(), v.rend());
+        for (size_t i = 0; i < v.size() && i < 40; ++i)
+        {
+            const auto &g = s.groups[v[i].second];
+            std::fprintf(stderr, "[g0] grupo %s | prim/Present=%.1f ms/Present=%.3f px/prim=%.0f | ej %s\n", v[i].second.c_str(), g.n / fr, g.ns / 1e6 / fr,
+                         g.n ? (double)g.px / g.n : 0.0, s.groupEx[v[i].second].c_str());
+        }
+        std::fflush(stderr);
+    }
