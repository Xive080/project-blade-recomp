diff --git a/ps2xIOP/tests/spu2_dsp_tests.cpp b/ps2xIOP/tests/spu2_dsp_tests.cpp
new file mode 100644
index 0000000..d577f7e
--- /dev/null
+++ b/ps2xIOP/tests/spu2_dsp_tests.cpp
@@ -0,0 +1,177 @@
+// Prueba aislada del DSP del SPU2 (src/emulator/core/spu2_dsp.h) contra vectores calculados a mano.
+// Compilar: c++ -std=c++20 -I src tests/spu2_dsp_tests.cpp -o spu2_dsp_tests && ./spu2_dsp_tests
+#include "emulator/core/spu2_dsp.h"
+#include "spu2_adpcm_ref_vectors.h"
+
+#include <cstdio>
+#include <cstring>
+
+using namespace ps2x::iop::spu2;
+
+static int failures = 0;
+#define CHECK(cond)                                                                       \
+    do                                                                                    \
+    {                                                                                     \
+        if (!(cond))                                                                      \
+        {                                                                                 \
+            std::printf("FALLO %s:%d: %s\n", __FILE__, __LINE__, #cond);                  \
+            ++failures;                                                                   \
+        }                                                                                 \
+    } while (0)
+
+static void blockWithNibbles(uint8_t header, uint8_t flags, const int *nib, uint8_t *block)
+{
+    block[0] = header;
+    block[1] = flags;
+    for (int i = 0; i < 14; ++i)
+        block[2 + i] = static_cast<uint8_t>((nib[2 * i] & 0xF) | ((nib[2 * i + 1] & 0xF) << 4));
+}
+
+int main()
+{
+    uint8_t blk[16];
+    int16_t out[28];
+    int nib[28];
+
+    // 0) vectores independientes (FFmpeg adpcm_psx), un bloque cada vez con s1 = s2 = 0 (ver scripts/gen_adpcm_vectors.py).
+    //    Filtro 0 (sin realimentacion): debe coincidir al bit. Filtros 1..4: FFmpeg guarda mas precision que el hardware,
+    //    asi que el redondeo de cada muestra realimenta y difiere hasta ~36 LSB en el peor bloque (medido): tolerancia 40.
+    {
+        int maxDiffF0 = 0, maxDiffOther = 0;
+        for (int b = 0; b < 20; ++b)
+        {
+            AdpcmState st;
+            decodeAdpcmBlock(kRefAdpcmBlocks + b * 16, st, out);
+            const bool filter0 = (kRefAdpcmBlocks[b * 16] >> 4) == 0;
+            for (int i = 0; i < 28; ++i)
+            {
+                const int d = out[i] > kRefAdpcmPcm[b * 28 + i] ? out[i] - kRefAdpcmPcm[b * 28 + i] : kRefAdpcmPcm[b * 28 + i] - out[i];
+                (filter0 ? maxDiffF0 : maxDiffOther) = std::max(filter0 ? maxDiffF0 : maxDiffOther, d);
+            }
+        }
+        std::printf("vectores FFmpeg: dif. max filtro0=%d, filtros1-4=%d\n", maxDiffF0, maxDiffOther);
+        CHECK(maxDiffF0 == 0);
+        CHECK(maxDiffOther <= 40);
+    }
+    // 1) filtro 0, desplazamiento 12: la muestra es el nibble con signo (0x8 = -8)
+    {
+        const int v[8] = {1, 2, 3, 4, 5, 6, 7, 8};
+        std::memset(nib, 0, sizeof(nib));
+        std::memcpy(nib, v, sizeof(v));
+        blockWithNibbles(0x0C, 0, nib, blk);
+        AdpcmState st;
+        decodeAdpcmBlock(blk, st, out);
+        const int16_t esperado[8] = {1, 2, 3, 4, 5, 6, 7, -8};
+        for (int i = 0; i < 8; ++i)
+            CHECK(out[i] == esperado[i]);
+        CHECK(out[8] == 0 && out[27] == 0);
+    }
+    // 2) filtro 1 (60/64), desplazamiento 12, todos los nibbles = 1: 1,2,3,4,5,6,7,8 (calculado a mano: x+(60*prev+32)>>6)
+    {
+        for (int i = 0; i < 28; ++i)
+            nib[i] = 1;
+        blockWithNibbles(0x1C, 0, nib, blk);
+        AdpcmState st;
+        decodeAdpcmBlock(blk, st, out);
+        const int16_t esperado[8] = {1, 2, 3, 4, 5, 6, 7, 8};
+        for (int i = 0; i < 8; ++i)
+            CHECK(out[i] == esperado[i]);
+    }
+    // 3) filtro 2 (115/-52), desplazamiento 8, nibble 1 y luego ceros: 16, 29, 39, 47
+    {
+        std::memset(nib, 0, sizeof(nib));
+        nib[0] = 1;
+        blockWithNibbles(0x28, 0, nib, blk);
+        AdpcmState st;
+        decodeAdpcmBlock(blk, st, out);
+        CHECK(out[0] == 16);
+        CHECK(out[1] == 29);
+        CHECK(out[2] == 39);
+        CHECK(out[3] == 47);
+    }
+    // 4) saturacion: filtro 4, desplazamiento 0, nibble 7 (0x7000): 28672, luego satura a 32767
+    {
+        for (int i = 0; i < 28; ++i)
+            nib[i] = 7;
+        blockWithNibbles(0x40, 0, nib, blk);
+        AdpcmState st;
+        decodeAdpcmBlock(blk, st, out);
+        CHECK(out[0] == 28672);
+        CHECK(out[1] == 32767);
+    }
+    // 5) el estado pasa de un bloque al siguiente (continuidad del filtro)
+    {
+        std::memset(nib, 0, sizeof(nib));
+        blockWithNibbles(0x1C, 0, nib, blk); // filtro 1, todo ceros
+        AdpcmState st;
+        st.s1 = 640;
+        decodeAdpcmBlock(blk, st, out);
+        CHECK(out[0] == (640 * 60 + 32) / 64); // 600
+        CHECK(out[1] == (600 * 60 + 32) / 64); // 563 (36032/64 = 563,0)
+    }
+    // 6) banderas: se leen del byte 1
+    {
+        std::memset(blk, 0, 16);
+        blk[1] = kFlagEnd | kFlagRepeat | kFlagLoopStart;
+        CHECK((blk[1] & kFlagEnd) && (blk[1] & kFlagRepeat) && (blk[1] & kFlagLoopStart));
+    }
+    // 7) envolvente: ataque lineal, shift 11 (1 ciclo), paso +7: 7, 14, 21
+    {
+        Envelope e;
+        envelopeKeyOn(e);
+        const uint16_t adsr1 = 11 << 10; // ataque lineal, shift 11, paso 0 => +7
+        CHECK(envelopeTick(e, adsr1, 0) == 7);
+        CHECK(envelopeTick(e, adsr1, 0) == 14);
+        CHECK(envelopeTick(e, adsr1, 0) == 21);
+    }
+    // 8) ataque lineal con shift 12: un paso de +7 cada 2 muestras
+    {
+        Envelope e;
+        envelopeKeyOn(e);
+        const uint16_t adsr1 = 12 << 10;
+        CHECK(envelopeTick(e, adsr1, 0) == 7); // el primer paso se aplica en la primera muestra
+        CHECK(envelopeTick(e, adsr1, 0) == 7);
+        CHECK(envelopeTick(e, adsr1, 0) == 14);
+    }
+    // 9) liberacion exponencial desde 0x4000, shift 11: -8 * 0x4000 >> 15 = -4
+    {
+        Envelope e;
+        e.phase = EnvPhase::Release;
+        e.level = 0x4000;
+        e.counter = 1;
+        CHECK(envelopeTick(e, 0, 0x20 | 11) == 0x4000 - 4);
+    }
+    // 10) liberacion lineal llega a 0 y la fase pasa a Off; el ataque pasa a Decay en 0x7FFF y a Sustain en el nivel
+    {
+        Envelope e;
+        e.phase = EnvPhase::Release;
+        e.level = 10;
+        e.counter = 1;
+        envelopeTick(e, 0, 11); // lineal, -8
+        CHECK(e.level == 2 && e.phase == EnvPhase::Release);
+        envelopeTick(e, 0, 11);
+        CHECK(e.level == 0 && e.phase == EnvPhase::Off);
+        Envelope a;
+        envelopeKeyOn(a);
+        a.level = 0x7FF8;
+        envelopeTick(a, 11 << 10, 0);
+        CHECK(a.level == 0x7FFF && a.phase == EnvPhase::Decay);
+        CHECK(sustainLevel(0x000F) == 0x8000);
+        CHECK(sustainLevel(0x0000) == 0x0800);
+    }
+    // 11) interpolacion: senal constante => constante; t=0 => b; rampa lineal => lineal
+    {
+        CHECK(interpolate(100, 100, 100, 100, 2048) == 100);
+        CHECK(interpolate(0, 1000, 2000, 3000, 0) == 1000);
+        CHECK(interpolate(0, 1000, 2000, 3000, 2048) == 1500);
+    }
+    // 12) volumen fijo: 0x4000 (bit 14) es 0x8000 con signo = -1,0 negativo; 0x2000 = +0,5 (0x4000)
+    {
+        CHECK(fixedVolume(0x2000) == 0x4000);
+        CHECK(fixedVolume(0x3FFF) == 0x7FFE);
+        CHECK(fixedVolume(0x4000) == -0x8000);
+    }
+    if (failures == 0)
+        std::printf("spu2_dsp_tests: todas las pruebas pasan\n");
+    return failures ? 1 : 0;
+}
diff --git a/ps2xIOP/tests/spu2_mix_tests.cpp b/ps2xIOP/tests/spu2_mix_tests.cpp
new file mode 100644
index 0000000..769d794
--- /dev/null
+++ b/ps2xIOP/tests/spu2_mix_tests.cpp
@@ -0,0 +1,263 @@
+// Prueba del mezclador del SPU2 (iop_memory.cpp) sin el juego: sube a la RAM de sonido un bloque ADPCM con una senal
+// conocida por el puerto de datos (igual que el driver), arranca una voz por registros, avanza el reloj del IOP y mide
+// la salida (frecuencia, amplitud, ENDX, fin por KOFF y por bandera).
+// Compilar: c++ -std=c++20 -Iinclude -Isrc tests/spu2_mix_tests.cpp src/emulator/core/iop_memory.cpp -o spu2_mix_tests
+#include "emulator/core/iop_memory.h"
+#include "ps2x/iop/spu2_output.h"
+
+#include <cmath>
+#include <cstdio>
+#include <cstring>
+#include <vector>
+
+using ps2x::iop::detail::IopMemory;
+
+static int failures = 0;
+#define CHECK(cond)                                                              \
+    do                                                                           \
+    {                                                                            \
+        if (!(cond))                                                             \
+        {                                                                        \
+            std::printf("FALLO %s:%d: %s\n", __FILE__, __LINE__, #cond);         \
+            ++failures;                                                          \
+        }                                                                        \
+    } while (0)
+
+static std::vector<int16_t> g_out;
+static void sink(void *, const int16_t *frames, size_t n)
+{
+    g_out.insert(g_out.end(), frames, frames + n * 2);
+}
+
+constexpr uint32_t kBase = 0x1F900000u;
+constexpr uint32_t kCore1 = kBase + 0x400u;
+
+struct Rig
+{
+    IopMemory mem;
+    uint64_t cycles = 0;
+    Rig()
+    {
+        mem.setCycleSource(&cycles);
+        mem.reset();
+        g_out.clear();
+        ps2x::iop::setSpu2Sink(&sink, nullptr);
+    }
+    void w(uint32_t a, uint16_t v) { mem.write16(a, v); }
+    void upload(uint32_t byteAddr, const uint8_t *data, size_t bytes)
+    {
+        const uint32_t tsa = byteAddr / 2;
+        w(kCore1 + 0x1A8, tsa >> 16);
+        w(kCore1 + 0x1AA, tsa & 0xFFFF);
+        for (size_t i = 0; i < bytes; i += 2)
+            w(kCore1 + 0x1AC, static_cast<uint16_t>(data[i] | (data[i + 1] << 8)));
+    }
+    // configura el nucleo 1 como la inicializacion del juego: voces secas a L/R, volumen maestro maximo
+    void setupCore1()
+    {
+        w(kCore1 + 0x19A, 0xC000);
+        w(kCore1 + 0x198, 0x0C00);
+        w(kCore1 + 0x188, 0xFFFF); w(kCore1 + 0x18A, 0x00FF);
+        w(kCore1 + 0x190, 0xFFFF); w(kCore1 + 0x192, 0x00FF);
+        w(kBase + 0x788, 0x3FFF); w(kBase + 0x78A, 0x3FFF);
+    }
+    void voice(uint32_t slot, uint32_t ssaBytes, uint16_t pitch, uint16_t adsr1, uint16_t adsr2)
+    {
+        const uint32_t v = kCore1 + slot * 0x10, ad = kCore1 + 0x1C0 + slot * 0xC;
+        w(v + 0, 0x3FFF); w(v + 2, 0x3FFF);
+        w(v + 4, pitch); w(v + 6, adsr1); w(v + 8, adsr2);
+        w(ad + 0, (ssaBytes / 2) >> 16); w(ad + 2, (ssaBytes / 2) & 0xFFFF);
+    }
+    void run(double seconds)
+    {
+        cycles += static_cast<uint64_t>(seconds * 36864000.0);
+        mem.spuTick();
+        (void)mem.read16(kCore1 + 0x340); // fuerza avanzar hasta ahora
+    }
+};
+
+// bloque de una senal senoidal de periodo 28 muestras (filtro 0, desplazamiento 0: el nibble es muestra/4096)
+static void sineBlock(uint8_t *b, uint8_t flags)
+{
+    b[0] = 0x00;
+    b[1] = flags;
+    for (int i = 0; i < 28; ++i)
+    {
+        const int n = static_cast<int>(std::lround(std::sin(2 * M_PI * i / 28.0) * 6.0)); // +-6 -> +-24576
+        const uint8_t nib = static_cast<uint8_t>(n & 0xF);
+        if (i & 1)
+            b[2 + i / 2] |= static_cast<uint8_t>(nib << 4);
+        else
+            b[2 + i / 2] = nib;
+    }
+}
+
+static double measureHz(const std::vector<int16_t> &out, size_t from, size_t frames)
+{
+    int crossings = 0;
+    for (size_t i = from + 1; i < from + frames; ++i)
+        if (out[(i - 1) * 2] < 0 && out[i * 2] >= 0)
+            ++crossings;
+    return crossings * 48000.0 / frames;
+}
+
+int main()
+{
+    uint8_t blk[16];
+    // 1) bucle de un bloque a tono 0x1000: 48000/28 = 1714,3 Hz; a 0x2000: el doble
+    for (uint16_t pitch : {uint16_t(0x1000), uint16_t(0x2000), uint16_t(0x0800)})
+    {
+        Rig r;
+        sineBlock(blk, 0x01 | 0x02 | 0x04); // fin + repetir + inicio de bucle
+        r.upload(0x1000, blk, 16);
+        r.setupCore1();
+        r.voice(0, 0x1000, pitch, 0x000F, 0x0007);
+        r.w(kCore1 + 0x1A0, 1);
+        r.run(0.5);
+        CHECK(g_out.size() == 2u * 24000);
+        const double expect = 48000.0 / 28.0 * pitch / 4096.0;
+        const double hz = measureHz(g_out, 4800, 24000 - 4800);
+        std::printf("pitch 0x%04x: esperado %.1f Hz, medido %.1f Hz\n", pitch, expect, hz);
+        CHECK(std::fabs(hz - expect) < expect * 0.01 + 1.0);
+        int peak = 0;
+        for (size_t i = 4800 * 2; i < g_out.size(); ++i)
+            peak = std::max(peak, std::abs(static_cast<int>(g_out[i])));
+        // senal +-24576 * env 1,0 * volumen 0,9999 * maestro 0,9999: ~24570 (interpolacion cubica puede pasarse un poco)
+        std::printf("   pico %d\n", peak);
+        CHECK(peak > 23000 && peak < 27000);
+        CHECK((r.mem.read16(kCore1 + 0x340) & 1) != 0); // ENDX: la voz paso por el fin del bloque
+    }
+    // 2) bloque sin repetir: la voz se para, ENDX y silencio despues
+    {
+        Rig r;
+        sineBlock(blk, 0x01); // solo fin
+        r.upload(0x1000, blk, 16);
+        r.setupCore1();
+        r.voice(3, 0x1000, 0x1000, 0x000F, 0x0007);
+        r.w(kCore1 + 0x1A0, 1u << 3);
+        r.run(0.01);
+        CHECK((r.mem.read16(kCore1 + 0x340) & (1u << 3)) != 0);
+        CHECK(r.mem.read16(kCore1 + 3 * 0x10 + 0xA) == 0); // ENVX = 0
+        size_t nz = 0;
+        for (size_t i = 100 * 2; i < g_out.size(); ++i)
+            nz += g_out[i] != 0;
+        CHECK(nz == 0);
+    }
+    // 3) KOFF: la liberacion (ADSR2 = 7, lineal, -8<<4 por muestra) baja a 0 en unas 256 muestras
+    {
+        Rig r;
+        sineBlock(blk, 0x01 | 0x02 | 0x04);
+        r.upload(0x1000, blk, 16);
+        r.setupCore1();
+        r.voice(0, 0x1000, 0x1000, 0x000F, 0x0007);
+        r.w(kCore1 + 0x1A0, 1);
+        r.run(0.05);
+        r.w(kCore1 + 0x1A4, 1);
+        const size_t kOff = g_out.size() / 2;
+        r.run(0.05);
+        int tail = 0;
+        for (size_t i = (kOff + 400) * 2; i < g_out.size(); ++i)
+            tail = std::max(tail, std::abs(static_cast<int>(g_out[i])));
+        int before = 0;
+        for (size_t i = (kOff - 100) * 2; i < kOff * 2; ++i)
+            before = std::max(before, std::abs(static_cast<int>(g_out[i])));
+        std::printf("KOFF: pico antes %d, despues de 400 muestras %d\n", before, tail);
+        CHECK(before > 20000);
+        CHECK(tail == 0);
+    }
+    // 4) volumen: mitad de volumen de voz = mitad de amplitud; volumen maestro 0 = silencio
+    {
+        Rig r;
+        sineBlock(blk, 0x07);
+        r.upload(0x1000, blk, 16);
+        r.setupCore1();
+        r.voice(0, 0x1000, 0x1000, 0x000F, 0x0007);
+        r.w(kCore1 + 0, 0x2000); // 0.5
+        r.w(kCore1 + 2, 0x2000);
+        r.w(kCore1 + 0x1A0, 1);
+        r.run(0.2);
+        int peak = 0;
+        for (size_t i = 4800 * 2; i < g_out.size(); ++i)
+            peak = std::max(peak, std::abs(static_cast<int>(g_out[i])));
+        std::printf("volumen 0,5: pico %d\n", peak);
+        CHECK(peak > 11500 && peak < 13500);
+        g_out.clear();
+        r.w(kBase + 0x788, 0); r.w(kBase + 0x78A, 0);
+        r.run(0.1);
+        int p2 = 0;
+        for (int16_t s : g_out) p2 = std::max(p2, std::abs(static_cast<int>(s)));
+        CHECK(p2 == 0);
+    }
+    // 5) decaimiento de ENVX y posicion (NAX) del bucle con dos bloques: avanza 16 bytes cada 28 muestras
+    {
+        Rig r;
+        uint8_t two[32];
+        sineBlock(two, 0x04);
+        sineBlock(two + 16, 0x03);
+        r.upload(0x1000, two, 32);
+        r.setupCore1();
+        r.voice(0, 0x1000, 0x1000, 0x000F, 0x0007);
+        r.w(kCore1 + 0x1A0, 1);
+        r.cycles += 768 * 30; // 30 muestras: el bloque 1 (muestras 28..55) ya suena
+        (void)r.mem.read16(kCore1 + 0x340);
+        const uint32_t nax = (r.mem.read16(kCore1 + 0x1C8) << 17) | (r.mem.read16(kCore1 + 0x1CA) << 1);
+        CHECK(nax == 0x1010);
+    }
+    // 6) reverb: una voz solo en el bus humedo y con el efecto activado deja una cola tras el KOFF; sin efecto, silencio
+    for (int effects = 0; effects < 2; ++effects)
+    {
+        Rig r;
+        sineBlock(blk, 0x07);
+        r.upload(0x1000, blk, 16);
+        r.setupCore1();
+        r.w(kCore1 + 0x188, 0); r.w(kCore1 + 0x18A, 0); r.w(kCore1 + 0x190, 0); r.w(kCore1 + 0x192, 0); // nada seco
+        r.w(kCore1 + 0x18C, 0xFFFF); r.w(kCore1 + 0x18E, 0x00FF); r.w(kCore1 + 0x194, 0xFFFF); r.w(kCore1 + 0x196, 0x00FF); // todo humedo
+        r.w(kCore1 + 0x198, 0x0F00);               // MMIX: voz seca y humeda L/R
+        r.w(kCore1 + 0x19A, effects ? 0xC080 : 0xC000);
+        // anillo de 0x8000 palabras en 0x1C0000 (ESA = 0x0E0000 palabras) y los registros de un preset del juego
+        r.w(kCore1 + 0x2E0, 0x000E); r.w(kCore1 + 0x2E2, 0x0000); r.w(kCore1 + 0x33C, 0x000E);
+        const uint32_t regs[22] = {0x0694, 0x04E4, 0x56E8, 0x46EC, 0x5308, 0x42F4, 0x46F0, 0x3704, 0x4700, 0x370C, 0x3700,
+                                   0x2704, 0x2F10, 0x1F04, 0x2800, 0x1B34, 0x2708, 0x1704, 0x1700, 0x1068, 0x09D0, 0x04E8};
+        for (int i = 0; i < 22; ++i)
+        {
+            r.w(kCore1 + 0x2E4 + i * 4, regs[i] >> 16);
+            r.w(kCore1 + 0x2E6 + i * 4, regs[i] & 0xFFFF);
+        }
+        const uint16_t vols[10] = {0x6000, 0x5000, 0x4C00, 0xB800, 0xBC00, 0xC000, 0x6000, 0x5C00, 0x8000, 0x8000};
+        for (int i = 0; i < 10; ++i)
+            r.w(kBase + 0x788 + 0x14 + i * 2, vols[i]);
+        r.w(kBase + 0x788 + 4, 0x3FFF); r.w(kBase + 0x788 + 6, 0x3FFF); // EVOL
+        r.voice(0, 0x1000, 0x1000, 0x000F, 0x0007);
+        r.w(kCore1 + 0x1A0, 1);
+        r.run(0.2);
+        r.w(kCore1 + 0x1A4, 1);
+        const size_t kOff = g_out.size() / 2;
+        r.run(0.5);
+        double tail = 0;
+        int peak = 0;
+        for (size_t i = (kOff + 4800) * 2; i < g_out.size(); ++i)
+        {
+            tail += static_cast<double>(g_out[i]) * g_out[i];
+            peak = std::max(peak, std::abs(static_cast<int>(g_out[i])));
+        }
+        std::printf("reverb %s: energia de la cola %.0f, pico %d\n", effects ? "activo" : "apagado", tail, peak);
+        if (effects)
+        {
+            CHECK(tail > 1e6 && peak < 32767);
+            double first = 0, last = 0;
+            for (size_t i = 0; i < 4800; ++i)
+            {
+                const double a = g_out[(kOff + 4800 + i) * 2], b = g_out[(g_out.size() / 2 - 4800 + i) * 2];
+                first += a * a;
+                last += b * b;
+            }
+            std::printf("   energia 0,1 s tras el KOFF %.0f, ultimos 0,1 s %.0f (debe decaer)\n", first, last);
+            CHECK(last < first);
+        }
+        else
+            CHECK(tail == 0);
+    }
+    if (failures == 0)
+        std::printf("spu2_mix_tests: todas las pruebas pasan\n");
+    return failures ? 1 : 0;
+}
