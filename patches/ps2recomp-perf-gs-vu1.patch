+                                     std::max<u32>(ctx.frame.fbw, 1u), x, y);
+    default:
+        return z > ReadVramUnlocked(ctx.zbuf.psm, GSInternal::framePageBaseToBlock(ctx.zbuf.zbp),
+                                    std::max<u32>(ctx.frame.fbw, 1u), x, y);
+    }
