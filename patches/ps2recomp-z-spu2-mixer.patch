+            coreOut[core][0] = spu2::clamp16(outL);
+            coreOut[core][1] = spu2::clamp16(outR);
+            if (core == 0u)
+            {
+                m_spuCore0Out[0] = coreOut[0][0];
+                m_spuCore0Out[1] = coreOut[0][1];
+            }
+        }
+        outLeft = static_cast<int16_t>(coreOut[1][0]);
+        outRight = static_cast<int16_t>(coreOut[1][1]);
+        m_spuPeakOut = std::max({m_spuPeakOut, std::abs(coreOut[1][0]), std::abs(coreOut[1][1])});
+    }
+
+    namespace
+    {
+        // FIR de remuestreo del reverb (39 coeficientes, ganancia 1,0 en continua; los mismos del SPU de PS1)
+        constexpr int32_t kRevFir[39] = {-1, 0, 2, 0, -10, 0, 35, 0, -103, 0, 266, 0, -616, 0, 1332, 0, -2960, 0, 10246, 0x4000,
+                                         10246, 0, -2960, 0, 1332, 0, -616, 0, 266, 0, -103, 0, 35, 0, -10, 0, 2, 0, -1};
