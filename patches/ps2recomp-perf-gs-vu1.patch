+// ---- Dibujo por franjas en varios hilos ----
+
+struct GSCpuBackend::BandPool
+{
+    explicit BandPool(uint32_t count) : count(count)
+    {
+        for (uint32_t i = 1; i < count; ++i)
+            threads.emplace_back([this, i]()
+                                 { loop(i); });
+    }
+
+    ~BandPool()
+    {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            stop = true;
+        }
+        cv.notify_all();
+        for (std::thread &t : threads)
+            t.join();
+    }
+
+    void run(const std::function<void()> &fn)
+    {
+        {
+            std::lock_guard<std::mutex> lock(mutex);
+            job = &fn;
+            pending = count - 1u;
+            ++generation;
+        }
+        cv.notify_all();
+        t_rowBand = RowBand{0u, count};
+        fn();
+        t_rowBand = RowBand{};
+        std::unique_lock<std::mutex> lock(mutex);
+        doneCv.wait(lock, [&]()
+                    { return pending == 0u; });
+        job = nullptr;
+    }
+
+    void loop(uint32_t index)
+    {
+        uint64_t seen = 0;
+        for (;;)
+        {
+            const std::function<void()> *fn = nullptr;
+            {
+                std::unique_lock<std::mutex> lock(mutex);
+                cv.wait(lock, [&]()
+                        { return stop || generation != seen; });
+                if (stop)
+                    return;
+                seen = generation;
+                fn = job;
+            }
+            t_rowBand = RowBand{index, count};
+            (*fn)();
+            t_rowBand = RowBand{};
+            {
+                std::lock_guard<std::mutex> lock(mutex);
+                --pending;
+            }
+            doneCv.notify_one();
+        }
+    }
+
+    uint32_t count;
+    std::vector<std::thread> threads;
+    std::mutex mutex;
+    std::condition_variable cv;
+    std::condition_variable doneCv;
+    const std::function<void()> *job = nullptr;
+    uint64_t generation = 0;
+    uint32_t pending = 0;
+    bool stop = false;
+};
+
+namespace
+{
+    constexpr uint32_t kVramPages = 512u;
+
+    // Intervalo de paginas de 8 KB (modulo la VRAM de 4 MB)
+    struct PageRange
+    {
+        uint32_t start = 0;
+        uint32_t count = 0;
+    };
+
+    bool rangesOverlap(PageRange a, PageRange b)
+    {
+        if (a.count == 0u || b.count == 0u)
+            return false;
+        if (a.count >= kVramPages || b.count >= kVramPages)
+            return true;
+        const uint32_t ab = (b.start + kVramPages - a.start) % kVramPages;
+        const uint32_t ba = (a.start + kVramPages - b.start) % kVramPages;
+        return ab < a.count || ba < b.count;
+    }
+
+    uint32_t pageHeightForPsm(uint32_t psm)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT16:
+        case GS_PSM_CT16S:
+        case GS_PSM_Z16:
+        case GS_PSM_Z16S:
+            return 64u;
+        case GS_PSM_T8:
+            return 64u;
+        case GS_PSM_T4:
+            return 128u;
+        default:
+            return 32u;
+        }
+    }
+
+    uint32_t pageWidthForPsm(uint32_t psm)
+    {
+        return (psm == GS_PSM_T8 || psm == GS_PSM_T4) ? 128u : 64u;
+    }
+
+    // Paginas que puede tocar un buffer de FRAME/ZBUF (base en paginas, ancho en unidades de 64) hasta la fila y1
+    PageRange targetRange(uint32_t basePage, uint32_t fbw, uint32_t psm, int y1)
+    {
+        const uint32_t rows = (static_cast<uint32_t>(std::max(y1, 0)) / pageHeightForPsm(psm)) + 1u;
+        const uint32_t perRow = std::max<uint32_t>(fbw, 1u);
+        return {basePage % kVramPages, std::min<uint32_t>(rows * perRow + 1u, kVramPages)};
+    }
+
+    // Paginas que puede leer la textura de TEX0 (conservador: filas enteras y coordenadas de region hasta 1024)
+    PageRange textureRange(const GSDrawState &state)
+    {
+        const auto &tex = state.context.tex0;
+        const uint64_t clamp = state.context.clamp;
+        const uint32_t wrapU = static_cast<uint32_t>(clamp & 3u);
+        const uint32_t wrapV = static_cast<uint32_t>((clamp >> 2) & 3u);
+        uint32_t w = std::max<uint32_t>(state.textureWidth, 1u);
+        uint32_t h = std::max<uint32_t>(state.textureHeight, 1u);
+        if (wrapU >= 2u)
+            w = std::max<uint32_t>(w, 1024u);
+        if (wrapV >= 2u)
+            h = std::max<uint32_t>(h, 1024u);
+        const uint32_t pageW = pageWidthForPsm(tex.psm);
+        const uint32_t pageH = pageHeightForPsm(tex.psm);
+        const uint32_t perRow = std::max<uint32_t>((static_cast<uint32_t>(tex.tbw) * 64u) / pageW, 1u);
+        const uint32_t rows = h / pageH + 2u;
+        const uint32_t count = rows * perRow + w / pageW + 2u;
+        return {(tex.tbp0 / 32u) % kVramPages, std::min<uint32_t>(count, kVramPages)};
+    }
+
+    bool zbufferUsed(const GSContext &ctx)
+    {
+        const uint32_t ztst = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+        return ztst >= 2u || (ztst == 1u && !ctx.zbuf.zmask);
+    }
+
+    // Clave de tramo: primitivas con el mismo destino y scissor se pueden repartir juntas
+    bool sameTarget(const GSDrawState &a, const GSDrawState &b)
+    {
+        const auto &ca = a.context;
+        const auto &cb = b.context;
+        return ca.frame.fbp == cb.frame.fbp && ca.frame.fbw == cb.frame.fbw && ca.frame.psm == cb.frame.psm &&
+               ca.zbuf.zbp == cb.zbuf.zbp && ca.zbuf.psm == cb.zbuf.psm && zbufferUsed(ca) == zbufferUsed(cb) &&
+               ca.scissor.y1 == cb.scissor.y1;
+    }
+
+    uint32_t approximatePixels(const GSPrimitiveBatch &batch)
+    {
+        const uint32_t n = std::max<uint32_t>(1u, std::min<uint32_t>(batch.vertexCount, 3u));
+        float x0 = batch.vertices[0].x, x1 = x0, y0 = batch.vertices[0].y, y1 = y0;
+        for (uint32_t i = 1; i < n; ++i)
+        {
+            x0 = std::min(x0, batch.vertices[i].x);
+            x1 = std::max(x1, batch.vertices[i].x);
+            y0 = std::min(y0, batch.vertices[i].y);
+            y1 = std::max(y1, batch.vertices[i].y);
+        }
+        const float area = (x1 - x0 + 1.0f) * (y1 - y0 + 1.0f);
+        return area > 1.0e6f ? 1000000u : static_cast<uint32_t>(std::max(area, 1.0f));
+    }
+
+    uint32_t bandCountFromEnvironment()
+    {
+        if (const char *env = std::getenv("PS2X_GS_RASTER_THREADS"); env && *env)
+            return std::clamp<uint32_t>(static_cast<uint32_t>(std::strtoul(env, nullptr, 10)), 1u, 16u);
+        const uint32_t hw = std::max<uint32_t>(std::thread::hardware_concurrency(), 1u);
+        return std::clamp<uint32_t>(hw / 2u, 1u, 4u);
+    }
+}
+
+GSCpuBackend::~GSCpuBackend() = default;
+
+void GSCpuBackend::DrawRunParallel(const GSPrimitiveBatch *const *batches, size_t count)
+{
+    if (!m_bandPool)
+        m_bandPool = std::make_unique<BandPool>(m_bandCount);
+    const std::function<void()> fn = [this, batches, count]()
+    {
+        for (size_t i = 0; i < count; ++i)
+            DrawPrimitive(*batches[i]);
+    };
+    m_bandPool->run(fn);
+}
+
+void GSCpuBackend::SubmitMany(const GSPrimitiveBatch *const *batches, size_t count)
+{
+    std::lock_guard<std::mutex> lock(m_mutex);
+    if (!m_vram)
+        return;
+    if (m_bandCount == 0u)
+        m_bandCount = bandCountFromEnvironment();
+
+    size_t i = 0;
+    while (i < count)
+    {
+        const GSPrimitiveBatch &first = *batches[i];
+        if (first.vertexCount == 0u)
+        {
+            ++i;
+            continue;
+        }
+
+        // Tramo [i, j) con el mismo destino, sin texturas que lean ese destino
+        const GSContext &ctx = first.state.context;
+        const PageRange frameRange = targetRange(ctx.frame.fbp, ctx.frame.fbw, ctx.frame.psm, ctx.scissor.y1);
+        const bool zUsed = zbufferUsed(ctx);
+        const PageRange zRange = zUsed ? targetRange(ctx.zbuf.zbp, ctx.frame.fbw, ctx.zbuf.psm, ctx.scissor.y1) : PageRange{};
+        const bool targetOk = m_bandCount > 1u && !rangesOverlap(frameRange, zRange);
+
+        size_t j = i;
+        uint32_t pixels = 0;
+        if (targetOk)
+        {
+            while (j < count)
+            {
+                const GSPrimitiveBatch &b = *batches[j];
+                if (b.vertexCount == 0u)
+                {
+                    ++j;
+                    continue;
+                }
+                if (!sameTarget(first.state, b.state))
+                    break;
+                if (b.state.prim.tme)
+                {
+                    const PageRange texRange = textureRange(b.state);
+                    if (rangesOverlap(texRange, frameRange) || rangesOverlap(texRange, zRange))
+                        break;
+                }
+                pixels += approximatePixels(b);
+                ++j;
+            }
+        }
+
+        if (j - i >= 1u && pixels >= 4096u)
+        {
+            DrawRunParallel(batches + i, j - i);
+            i = j;
+            continue;
+        }
+
+        // En orden en este hilo: el tramo pequeno, o la primitiva que lo corta
+        const size_t end = (j > i) ? j : i + 1u;
+        for (; i < end; ++i)
+            if (batches[i]->vertexCount != 0u)
+                DrawPrimitive(*batches[i]);
+    }
+}
