+            r.upL[k] = r.upL[k - 1];
+            r.upR[k] = r.upR[k - 1];
+        }
+        r.upL[0] = stepped ? r.stepL : 0;
+        r.upR[0] = stepped ? r.stepR : 0;
+        outL = sat16(fir39(r.upL) * 2);
+        outR = sat16(fir39(r.upR) * 2);
+    }
