--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -178,6 +178,30 @@ inline double ps2_to_double(float x)
     return static_cast<double>(x);
 }
 
+// C.EQ.S/C.LT.S/C.LE.S. The PS2 has no NaN or Inf: exponent 255 is just a very large number (0x7FFFFFFF is what an
+// overflow leaves, e.g. FLT_MAX * FLT_MAX), so every comparison is ordered. The host would read those patterns as
+// NaN/Inf and answer false to all of them. Operands without exponent 255 keep the host comparison.
+inline bool ps2_fcmp_wide(float a, float b)
+{
+    return ((std::bit_cast<uint32_t>(a) & PS2_FLOAT_EXP_MASK) == PS2_FLOAT_EXP_MASK) |
+           ((std::bit_cast<uint32_t>(b) & PS2_FLOAT_EXP_MASK) == PS2_FLOAT_EXP_MASK);
+}
+
+inline bool ps2_fcmp_eq(float a, float b)
+{
+    return ps2_fcmp_wide(a, b) ? ps2_to_double(a) == ps2_to_double(b) : a == b;
+}
+
+inline bool ps2_fcmp_lt(float a, float b)
+{
+    return ps2_fcmp_wide(a, b) ? ps2_to_double(a) < ps2_to_double(b) : a < b;
+}
+
+inline bool ps2_fcmp_le(float a, float b)
+{
+    return ps2_fcmp_wide(a, b) ? ps2_to_double(a) <= ps2_to_double(b) : a <= b;
+}
+
