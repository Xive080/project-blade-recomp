+        [[nodiscard]] uint32_t spuOverride(uint32_t address, uint32_t stored) const;
+
+        const uint64_t *m_cycleSource = nullptr;
+        mutable std::vector<uint8_t> m_spuRam;
+        mutable std::array<SpuVoice, 48> m_spuVoices{};
+        mutable uint64_t m_spuLastCycle = 0;
+        mutable uint32_t m_spuEndx[2] = {0, 0};
     };
 }
