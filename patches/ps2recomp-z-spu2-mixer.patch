+    void IopMemory::spuRenderFrame(int16_t &outLeft, int16_t &outRight) const
+    {
+        int32_t coreOut[2][2] = {{0, 0}, {0, 0}};
+        for (uint32_t core = 0; core < 2u; ++core)
+        {
+            const uint32_t base = Spu2Base + core * kSpuCoreStride;
+            const auto reg32 = [&](uint32_t r) { return static_cast<uint32_t>(spuReg(base + r)) | (static_cast<uint32_t>(spuReg(base + r + 2u)) << 16u); };
+            const uint32_t vmixL = reg32(0x188u), vmixEL = reg32(0x18Cu), vmixR = reg32(0x190u), vmixER = reg32(0x194u);
+            int32_t dryL = 0, dryR = 0, wetL = 0, wetR = 0;
+            for (uint32_t slot = 0; slot < 24u; ++slot)
+            {
+                SpuVoice &voice = m_spuVoices[core * 24u + slot];
+                if (!voice.active)
+                    continue;
+                const uint32_t vb = base + slot * 0x10u;
+                const uint16_t adsr1 = spuReg(vb + 6u), adsr2 = spuReg(vb + 8u);
+                const uint32_t index = voice.counter >> 12u;
+                const int32_t sample = spu2::clamp16(spu2::interpolate(voice.win[index], voice.win[index + 1], voice.win[index + 2],
+                                                                      voice.win[index + 3], static_cast<int32_t>(voice.counter & 0xFFFu)));
+                const int32_t level = spu2::envelopeTick(voice.env, adsr1, adsr2);
+                const int32_t scaled = (sample * level) >> 15;
+                const int32_t vl = (scaled * spu2::fixedVolume(spuReg(vb))) >> 15;
+                const int32_t vr = (scaled * spu2::fixedVolume(spuReg(vb + 2u))) >> 15;
+                const uint32_t bit = 1u << slot;
+                if (vmixL & bit) dryL += vl;
+                if (vmixR & bit) dryR += vr;
+                if (vmixEL & bit) wetL += vl;
+                if (vmixER & bit) wetR += vr;
+                // avanzar el tono
+                const uint32_t pitch = std::min<uint32_t>(spuReg(vb + 4u), 0x3FFFu);
+                voice.counter += pitch;
+                if (voice.env.phase == spu2::EnvPhase::Off)
+                {
+                    voice.active = false;
+                    continue;
+                }
+                while (voice.active && voice.counter >= kBlockUnits)
+                {
+                    voice.counter -= kBlockUnits;
+                    const uint8_t flags = m_spuRam[(voice.nax + 1u) % kSpuRamBytes];
+                    if ((flags & spu2::kFlagEnd) != 0u)
+                    {
+                        m_spuEndx[core] |= bit;
+                        voice.nax = voice.lsax;
+                        if ((flags & spu2::kFlagRepeat) == 0u)
+                        {
+                            voice.active = false;
+                            voice.env.phase = spu2::EnvPhase::Off;
+                            voice.env.level = 0;
+                            break;
+                        }
+                    }
+                    else
+                    {
+                        voice.nax = (voice.nax + 16u) % kSpuRamBytes;
+                    }
+                    spuDecodeBlock(voice);
+                }
+            }
+            const uint16_t mmix = spuReg(base + 0x198u);
+            const uint16_t attr = spuReg(base + 0x19Au);
+            int32_t outL = 0, outR = 0;
+            m_spuPeakPre[core] = std::max({m_spuPeakPre[core], std::abs(dryL), std::abs(dryR)});
+            if (mmix & 0x800u) outL += dryL;
+            if (mmix & 0x400u) outR += dryR;
+            if ((attr & 0x80u) != 0u && spuReverbEnabled())
+            {
+                // reverb (bit 7 de ATTR): entrada humeda = voces con VMIXE* segun MMIX 0x200/0x100
+                int32_t revL = 0, revR = 0;
+                spuReverbFrame(core, (mmix & 0x200u) ? wetL : 0, (mmix & 0x100u) ? wetR : 0, revL, revR);
+                const uint32_t eb = Spu2Base + 0x760u + core * 0x28u;
+                outL += (revL * spu2::fixedVolume(spuReg(eb + 4u))) >> 15;
+                outR += (revR * spu2::fixedVolume(spuReg(eb + 6u))) >> 15;
+            }
+            if (core == 1u)
+            {
+                // entrada externa del nucleo 1: la salida del nucleo 0 escalada por AVOL
+                const uint32_t mb = Spu2Base + 0x760u + core * 0x28u;
+                // AVOL/BVOL no llevan el desplazamiento de MVOL: 0x7FFF es la escala completa (sceSdInit lo deja asi)
+                const int32_t extL = (m_spuCore0Out[0] * static_cast<int16_t>(spuReg(mb + 8u))) >> 15;
+                const int32_t extR = (m_spuCore0Out[1] * static_cast<int16_t>(spuReg(mb + 10u))) >> 15;
+                if (mmix & 0x08u) outL += extL;
+                if (mmix & 0x04u) outR += extR;
+            }
+            const uint32_t mb = Spu2Base + 0x760u + core * 0x28u;
+            // Volumen maestro. El driver del juego (TSSDRV) solo sube el del nucleo 0 y nunca escribe el del nucleo 1
+            // (libsd lo deja a 0 en sceSdInit); con la entrada estricta eso da silencio total. Modo "assume" (por
+            // defecto): un nucleo cuyo MVOL no ha tenido nunca un valor distinto de 0 se trata como volumen 1,0.
+            // PS2X_SPU_MASTER=strict aplica el registro tal cual. Ver AUDIO_IMPLEMENTATION_STATUS.md (hallazgo H1).
+            int32_t mvl = spu2::fixedVolume(spuReg(mb)), mvr = spu2::fixedVolume(spuReg(mb + 2u));
+            if (mvl != 0 || mvr != 0)
+                m_spuMasterSeen[core] = true;
+            else if (spuMasterAssume() && !m_spuMasterSeen[core])
