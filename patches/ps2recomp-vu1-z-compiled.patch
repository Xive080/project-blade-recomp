+# Microprogramas VU1 compilados: carpeta generada desde el disco del usuario (no versionada), p. ej.
+# -DPS2X_VU1GEN_DIR=<repo>/work/vu1gen (con vu1gen_table.inc y vu1gen_unit_N.inc). Cada trozo es una unidad de
+# compilacion (se compilan en paralelo). Sin la carpeta, el VU1 se interpreta como siempre. Hay que volver a
+# configurar con cmake despues de generar.
+set(PS2X_VU1GEN_DIR "" CACHE PATH "Generated compiled VU1 microprograms directory (see README)")
+if(PS2X_VU1GEN_DIR AND EXISTS "${PS2X_VU1GEN_DIR}/vu1gen_table.inc")
+    set_source_files_properties(src/lib/vu/ps2_vu1_gen.cpp PROPERTIES
+        COMPILE_DEFINITIONS "PS2X_VU1GEN_TABLE=\"${PS2X_VU1GEN_DIR}/vu1gen_table.inc\""
+        OBJECT_DEPENDS "${PS2X_VU1GEN_DIR}/vu1gen_table.inc")
+    file(GLOB PS2X_VU1GEN_UNITS "${PS2X_VU1GEN_DIR}/vu1gen_unit_*.inc")
+    foreach(unit ${PS2X_VU1GEN_UNITS})
+        get_filename_component(unit_name "${unit}" NAME_WE)
+        set(unit_cpp "${CMAKE_CURRENT_BINARY_DIR}/${unit_name}.cpp")
+        file(WRITE "${unit_cpp}" "#define VU1GEN_UNIT_FILE \"${unit}\"\n#include \"${CMAKE_CURRENT_SOURCE_DIR}/src/lib/vu/ps2_vu1_gen_unit.cpp\"\n")
+        target_sources(ps2_runtime PRIVATE "${unit_cpp}")
+        set_source_files_properties("${unit_cpp}" PROPERTIES OBJECT_DEPENDS "${unit}")
+    endforeach()
+endif()
+
 target_compile_definitions(ps2_runtime PRIVATE
     PS2X_HAS_FFMPEG=$<BOOL:${PS2X_ENABLE_FFMPEG}>
 )
