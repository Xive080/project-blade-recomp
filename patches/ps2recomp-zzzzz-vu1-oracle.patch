         target_sources(ps2_runtime PRIVATE "${unit_cpp}")
-        set_source_files_properties("${unit_cpp}" PROPERTIES OBJECT_DEPENDS "${unit}")
+        set_source_files_properties("${unit_cpp}" PROPERTIES OBJECT_DEPENDS "${unit}" COMPILE_OPTIONS "${PS2X_VU1_FP_FLAGS}")
     endforeach()
 endif()
 
