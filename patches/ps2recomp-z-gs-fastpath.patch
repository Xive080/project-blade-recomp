+namespace
+{
+    template <int P>
+    uint32_t sampleT(const GSTexPipe &tp, float s, float t, float q, uint16_t u, uint16_t v)
+    {
+        constexpr bool indexed = (P == GS_PSM_T8 || P == GS_PSM_T4 || P == GS_PSM_T8H || P == GS_PSM_T4HL || P == GS_PSM_T4HH);
+        constexpr bool sixteen = (P == GS_PSM_CT16 || P == GS_PSM_CT16S || P == GS_PSM_Z16 || P == GS_PSM_Z16S);
+
+        float texUf, texVf;
+        if (tp.fst)
+        {
+            texUf = static_cast<float>(u) / 16.0f;
+            texVf = static_cast<float>(v) / 16.0f;
+        }
+        else
+        {
+            const float invQ = 1.0f / fabsQ(q);
+            texUf = s * invQ * static_cast<float>(tp.texW);
+            texVf = t * invQ * static_cast<float>(tp.texH);
+        }
+
+        auto point = [&](int su, int sv) -> uint32_t
+        {
+            su = wrapTextureCoordinate(su, tp.texW, tp.wrapU, tp.minU, tp.maxU);
+            sv = wrapTextureCoordinate(sv, tp.texH, tp.wrapV, tp.minV, tp.maxV);
+            const uint32_t out = readTexT<P>(tp.vram, tp.tbp0, tp.tbw, static_cast<uint32_t>(su), static_cast<uint32_t>(sv));
+            if constexpr (indexed)
+                return tp.clut[static_cast<uint8_t>(out)];
+            else if constexpr (sixteen)
+                return applyTexa(tp.texa, static_cast<uint8_t>(P), Rgba5551ToRgba8888(static_cast<u16>(out)));
+            else
+                return applyTexa(tp.texa, static_cast<uint8_t>(P), out);
+        };
+
+        if (!tp.linear)
+            return point(static_cast<int>(texUf), static_cast<int>(texVf));
+
+        const float sampleU = texUf - 0.5f;
+        const float sampleV = texVf - 0.5f;
+        const int u0 = static_cast<int>(std::floor(sampleU));
+        const int v0 = static_cast<int>(std::floor(sampleV));
+        const int u1 = u0 + 1;
+        const int v1 = v0 + 1;
+        const float fx = sampleU - static_cast<float>(u0);
+        const float fy = sampleV - static_cast<float>(v0);
+
+        const uint32_t c00 = point(u0, v0);
+        const uint32_t c10 = point(u1, v0);
+        const uint32_t c01 = point(u0, v1);
+        const uint32_t c11 = point(u1, v1);
+
+        const uint8_t r = lerpChannel(static_cast<uint8_t>(c00 & 0xFFu), static_cast<uint8_t>(c10 & 0xFFu),
+                                      static_cast<uint8_t>(c01 & 0xFFu), static_cast<uint8_t>(c11 & 0xFFu), fx, fy);
+        const uint8_t g = lerpChannel(static_cast<uint8_t>((c00 >> 8) & 0xFFu), static_cast<uint8_t>((c10 >> 8) & 0xFFu),
+                                      static_cast<uint8_t>((c01 >> 8) & 0xFFu), static_cast<uint8_t>((c11 >> 8) & 0xFFu), fx, fy);
+        const uint8_t b = lerpChannel(static_cast<uint8_t>((c00 >> 16) & 0xFFu), static_cast<uint8_t>((c10 >> 16) & 0xFFu),
+                                      static_cast<uint8_t>((c01 >> 16) & 0xFFu), static_cast<uint8_t>((c11 >> 16) & 0xFFu), fx, fy);
+        const uint8_t a = lerpChannel(static_cast<uint8_t>((c00 >> 24) & 0xFFu), static_cast<uint8_t>((c10 >> 24) & 0xFFu),
+                                      static_cast<uint8_t>((c01 >> 24) & 0xFFu), static_cast<uint8_t>((c11 >> 24) & 0xFFu), fx, fy);
+        return static_cast<uint32_t>(r) | (static_cast<uint32_t>(g) << 8) | (static_cast<uint32_t>(b) << 16) | (static_cast<uint32_t>(a) << 24);
+    }
+
+    GSTexPipe::Fn selectSampler(uint8_t psm)
+    {
+        switch (psm)
+        {
+        case GS_PSM_CT32: return &sampleT<GS_PSM_CT32>;
+        case GS_PSM_CT24: return &sampleT<GS_PSM_CT24>;
+        case GS_PSM_CT16: return &sampleT<GS_PSM_CT16>;
+        case GS_PSM_CT16S: return &sampleT<GS_PSM_CT16S>;
+        case GS_PSM_T8: return &sampleT<GS_PSM_T8>;
+        case GS_PSM_T4: return &sampleT<GS_PSM_T4>;
+        case GS_PSM_T8H: return &sampleT<GS_PSM_T8H>;
+        case GS_PSM_T4HL: return &sampleT<GS_PSM_T4HL>;
+        case GS_PSM_T4HH: return &sampleT<GS_PSM_T4HH>;
+        case GS_PSM_Z32: return &sampleT<GS_PSM_Z32>;
+        case GS_PSM_Z24: return &sampleT<GS_PSM_Z24>;
+        case GS_PSM_Z16: return &sampleT<GS_PSM_Z16>;
+        case GS_PSM_Z16S: return &sampleT<GS_PSM_Z16S>;
+        default: return nullptr;
+        }
+    }
+
+    // Paleta (CLUT + TEXA ya aplicados) de cada hilo; se rehace solo si cambia el CLUT cargado o los parametros.
+    struct ClutCache
+    {
+        const void *owner = nullptr;
+        uint64_t generation = 0;
+        uint8_t cpsm = 0, csm = 0, csa = 0, psm = 0;
+        GSTexaReg texa{};
+        bool valid = false;
+        uint32_t table[256];
+    };
+    thread_local ClutCache t_clutCache;
+}
+
+void GSCpuBackend::BuildTexPipe(const GSDrawState &state, GSTexPipe &tp)
+{
+    const auto &ctx = state.context;
+    const auto &tex = ctx.tex0;
+    tp.fn = selectSampler(tex.psm);
+    tp.vram = m_vram;
+    tp.tbp0 = tex.tbp0;
+    tp.tbw = tex.tbw;
+    tp.texW = state.textureWidth;
+    tp.texH = state.textureHeight;
+    const uint64_t clamp = ctx.clamp;
+    tp.wrapU = static_cast<uint8_t>(clamp & 0x3u);
+    tp.wrapV = static_cast<uint8_t>((clamp >> 2) & 0x3u);
+    tp.minU = static_cast<uint16_t>((clamp >> 4) & 0x3FFu);
+    tp.maxU = static_cast<uint16_t>((clamp >> 14) & 0x3FFu);
+    tp.minV = static_cast<uint16_t>((clamp >> 24) & 0x3FFu);
+    tp.maxV = static_cast<uint16_t>((clamp >> 34) & 0x3FFu);
+    tp.fst = state.prim.fst;
+    tp.linear = state.linearFilter;
+    tp.texa = state.texa;
+    tp.clut = nullptr;
+    if (tp.fn && (isFourBitIndexedPsm(tex.psm) || isEightBitIndexedPsm(tex.psm)))
+    {
+        ClutCache &cc = t_clutCache;
+        const bool same = cc.valid && cc.owner == this && cc.generation == m_clutGeneration && cc.cpsm == tex.cpsm &&
+                          cc.csm == tex.csm && cc.csa == tex.csa && cc.psm == tex.psm &&
+                          cc.texa.ta0 == state.texa.ta0 && cc.texa.ta1 == state.texa.ta1 && cc.texa.aem == state.texa.aem;
+        if (!same)
+        {
+            const uint32_t n = isFourBitIndexedPsm(tex.psm) ? 16u : 256u;
+            for (uint32_t i = 0; i < n; ++i)
+                cc.table[i] = LookupCLUT(state, static_cast<uint8_t>(i), tex.cpsm, tex.csm, tex.csa, tex.psm);
+            cc.owner = this;
+            cc.generation = m_clutGeneration;
+            cc.cpsm = tex.cpsm;
+            cc.csm = tex.csm;
+            cc.csa = tex.csa;
+            cc.psm = tex.psm;
+            cc.texa = state.texa;
+            cc.valid = true;
+        }
+        tp.clut = cc.table;
+    }
+}
