diff --git a/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
new file mode 100644
index 0000000..4b5fcdf
--- /dev/null
+++ b/ps2xRuntime/src/lib/gs/gs_threaded_backend.cpp
@@ -0,0 +1,281 @@
+#include "runtime/gs/gs_threaded_backend.h"
+
+#include <cstdlib>
+#include <cstring>
+
+bool GSThreadedBackend::EnabledByEnvironment()
+{
+    const char *env = std::getenv("PS2X_GS_THREAD");
+    return !(env && env[0] == '0');
+}
+
+GSThreadedBackend::GSThreadedBackend(std::unique_ptr<GSCpuBackend> inner)
+    : m_inner(std::move(inner)), m_current(std::make_unique<Chunk>())
+{
+    m_current->commands.reserve(kPublishCommands);
+    m_worker = std::thread([this]()
+                           { workerLoop(); });
+}
+
+GSThreadedBackend::~GSThreadedBackend()
+{
+    {
+        std::lock_guard<std::mutex> lock(m_producerMutex);
+        publishLocked();
+    }
+    {
+        std::lock_guard<std::mutex> lock(m_queueMutex);
+        m_stop = true;
+    }
+    m_queueCv.notify_all();
+    if (m_worker.joinable())
+        m_worker.join();
+}
+
+GSThreadedBackend::Command &GSThreadedBackend::appendLocked(Op op)
+{
+    Command &cmd = m_current->commands.emplace_back();
+    cmd.op = op;
+    return cmd;
+}
+
+void GSThreadedBackend::publishLocked()
+{
+    if (m_current->commands.empty())
+        return;
+    std::unique_ptr<Chunk> next;
+    bool wake = false;
+    {
+        std::lock_guard<std::mutex> lock(m_queueMutex);
+        m_queue.push_back(std::move(m_current));
+        ++m_queuedChunks;
+        wake = m_workerWaiting;
+        if (!m_free.empty())
+        {
+            next = std::move(m_free.back());
+            m_free.pop_back();
+        }
+    }
+    if (wake)
+        m_queueCv.notify_one();
+    if (!next)
+    {
+        next = std::make_unique<Chunk>();
+        next->commands.reserve(kPublishCommands);
+    }
+    m_current = std::move(next);
+}
+
+void GSThreadedBackend::waitIdle() const
+{
+    uint64_t target = 0;
+    {
+        std::lock_guard<std::mutex> lock(m_producerMutex);
+        const_cast<GSThreadedBackend *>(this)->publishLocked();
+        std::lock_guard<std::mutex> queueLock(m_queueMutex);
+        target = m_queuedChunks;
+    }
+    std::unique_lock<std::mutex> lock(m_queueMutex);
+    m_doneCv.wait(lock, [&]()
+                  { return m_completedChunks >= target; });
+}
+
+void GSThreadedBackend::workerLoop()
+{
+    for (;;)
+    {
+        std::unique_ptr<Chunk> chunk;
+        {
+            std::unique_lock<std::mutex> lock(m_queueMutex);
+            while (m_queue.empty() && !m_stop)
+            {
+                m_workerWaiting = true;
+                m_queueCv.wait(lock);
+                m_workerWaiting = false;
+            }
+            if (m_queue.empty())
+                return;
+            chunk = std::move(m_queue.front());
+            m_queue.pop_front();
+        }
+
+        // Las primitivas seguidas van juntas al backend de CPU, que reparte por filas las que puede.
+        const std::vector<Command> &commands = chunk->commands;
+        for (size_t i = 0; i < commands.size();)
+        {
+            if (commands[i].op != Op::Submit)
+            {
+                execute(*chunk, commands[i]);
+                ++i;
+                continue;
+            }
+            m_runScratch.clear();
+            while (i < commands.size() && commands[i].op == Op::Submit)
+                m_runScratch.push_back(&commands[i++].batch);
+            m_inner->SubmitMany(m_runScratch.data(), m_runScratch.size());
+        }
+        chunk->commands.clear();
+        chunk->data.clear();
+
+        {
+            std::lock_guard<std::mutex> lock(m_queueMutex);
+            ++m_completedChunks;
+            m_free.push_back(std::move(chunk));
+        }
+        m_doneCv.notify_all();
+    }
+}
+
+void GSThreadedBackend::execute(const Chunk &chunk, const Command &cmd)
+{
+    switch (cmd.op)
+    {
+    case Op::Submit:
+        m_inner->Submit(cmd.batch);
+        break;
+    case Op::LoadClut:
+        m_inner->LoadClut(cmd.tex0, cmd.texclut);
+        break;
+    case Op::BeginTransfer:
+        m_inner->BeginTransfer(cmd.transfer);
+        break;
+    case Op::Upload:
+        m_inner->UploadImage(chunk.data.data() + cmd.a, cmd.b);
+        break;
+    case Op::TextureFlush:
+        m_inner->TextureFlush();
+        break;
+    case Op::Clear:
+        m_inner->ClearFramebuffer(cmd.batch.state.context, cmd.a);
+        break;
+    case Op::WriteVram:
+        m_inner->WriteVram(cmd.a, cmd.b, cmd.c, cmd.d, cmd.e, cmd.f);
+        break;
+    }
+}
+
+void GSThreadedBackend::Initialize(uint8_t *vram, uint32_t vramSize)
+{
+    waitIdle();
+    m_inner->Initialize(vram, vramSize);
+    m_hasVram = vram != nullptr;
+}
+
+void GSThreadedBackend::Reset()
+{
+    waitIdle();
+    m_inner->Reset();
+}
+
+void GSThreadedBackend::Submit(const GSPrimitiveBatch &batch)
+{
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    appendLocked(Op::Submit).batch = batch;
+    if (m_current->commands.size() >= kPublishCommands)
+        publishLocked();
+}
+
+void GSThreadedBackend::LoadClut(const GSTex0Reg &tex0, const GSTexClutReg &texclut)
+{
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    Command &cmd = appendLocked(Op::LoadClut);
+    cmd.tex0 = tex0;
+    cmd.texclut = texclut;
+}
+
+void GSThreadedBackend::BeginTransfer(const GSTransferCommand &command)
+{
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    appendLocked(Op::BeginTransfer).transfer = command;
+    // Las copias local->local son caras: que empiecen ya.
+    publishLocked();
+}
+
+void GSThreadedBackend::UploadImage(const uint8_t *data, uint32_t sizeBytes)
+{
+    if (!data || sizeBytes == 0u)
+        return;
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    Command &cmd = appendLocked(Op::Upload);
+    cmd.a = static_cast<uint32_t>(m_current->data.size());
+    cmd.b = sizeBytes;
+    m_current->data.insert(m_current->data.end(), data, data + sizeBytes);
+    if (m_current->data.size() >= kPublishBytes)
+        publishLocked();
+}
+
+void GSThreadedBackend::Flush()
+{
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    publishLocked();
+}
+
+void GSThreadedBackend::TextureFlush()
+{
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    appendLocked(Op::TextureFlush);
+}
+
+void GSThreadedBackend::Sync(GSSyncReason reason)
+{
+    waitIdle();
+    m_inner->Sync(reason);
+}
+
+PresentationFrame GSThreadedBackend::Present(const GSPresentationRequest &request)
+{
+    waitIdle();
+    return m_inner->Present(request);
+}
+
+bool GSThreadedBackend::ClearFramebuffer(const GSContext &context, uint32_t rgba)
+{
+    // Mismo resultado que GSCpuBackend::ClearFramebuffer, que solo depende de los argumentos.
+    const bool handled = m_hasVram && context.frame.fbw != 0u &&
+                         (context.frame.psm == GS_PSM_CT32 || context.frame.psm == GS_PSM_CT24 ||
+                          context.frame.psm == GS_PSM_CT16 || context.frame.psm == GS_PSM_CT16S);
+    if (!handled)
+        return false;
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    Command &cmd = appendLocked(Op::Clear);
+    cmd.batch.state.context = context;
+    cmd.a = rgba;
+    publishLocked();
+    return true;
+}
+
+uint32_t GSThreadedBackend::ConsumeLocalToHostBytes(uint8_t *dst, uint32_t maxBytes)
+{
+    waitIdle();
+    return m_inner->ConsumeLocalToHostBytes(dst, maxBytes);
+}
+
+uint32_t GSThreadedBackend::ReadVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y) const
+{
+    waitIdle();
+    return m_inner->ReadVram(psm, base, bw, x, y);
+}
+
+void GSThreadedBackend::WriteVram(uint32_t psm, uint32_t base, uint32_t bw, uint32_t x, uint32_t y, uint32_t value)
+{
+    std::lock_guard<std::mutex> lock(m_producerMutex);
+    Command &cmd = appendLocked(Op::WriteVram);
+    cmd.a = psm;
+    cmd.b = base;
+    cmd.c = bw;
+    cmd.d = x;
+    cmd.e = y;
+    cmd.f = value;
+}
+
+void GSThreadedBackend::SnapshotVram(std::vector<uint8_t> &out) const
+{
+    waitIdle();
+    m_inner->SnapshotVram(out);
+}
+
+GSTransferSnapshot GSThreadedBackend::GetTransferSnapshot() const
+{
+    waitIdle();
+    return m_inner->GetTransferSnapshot();
+}
