+// Final del monticulo del juego (SetupHeap/EndOfHeap) y suelo de las pilas de callbacks del runtime, que bajan
+// desde el final de la RAM. En la consola el monticulo llega hasta la pila del hilo principal; aqui se dejan 512 KB
+// para esa pila y las de callbacks. Antes era 0x01F00000 (los pools HLE vivian ahi; ahora estan en la RAM del kernel,
+// ver kRpcPacketPoolBase) y los juegos que llenan el monticulo (AirBlade: raster de la sombra, 256 KB) se quedaban
+// sin memoria donde la consola aun tiene ~1 MB.
+inline constexpr uint32_t PS2_GUEST_HEAP_HARD_LIMIT = 0x01F80000u;
+
 inline constexpr uint32_t PS2_PATH_WATCH_ADDR = 0x01EFFFA0u;
 inline constexpr uint32_t PS2_PATH_WATCH_BYTES = 0x200u;
 
@@ -513,7 +520,7 @@ private:
     uint32_t m_guestHeapLimit = PS2_RAM_SIZE;
     uint32_t m_guestHeapSuggestedBase = 0x00100000u;
     bool m_guestHeapConfigured = false;
-    uint32_t m_asyncCallbackStackFloor = 0x01F00000u;
+    uint32_t m_asyncCallbackStackFloor = PS2_GUEST_HEAP_HARD_LIMIT;
     uint32_t m_asyncCallbackStackTop = PS2_RAM_SIZE;
 
     std::atomic<uint32_t> m_missingFunctionPolicy{static_cast<uint32_t>(MissingFunctionPolicy::ContinueToTarget)};
