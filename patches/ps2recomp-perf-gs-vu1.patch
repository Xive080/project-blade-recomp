+bool GSCpuBackend::EarlyDepthPass(const GSDrawState &state, int x, int y, uint32_t z) const
+{
+    const auto &ctx = state.context;
+    if (x < ctx.scissor.x0 || x > ctx.scissor.x1 || y < ctx.scissor.y0 || y > ctx.scissor.y1)
+        return false;
+    switch (static_cast<uint32_t>((ctx.test >> 17) & 3u))
