new file mode 100644
index 0000000..92a3ab0
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_gen_unit.cpp
@@ -0,0 +1,54 @@
+// Una unidad de compilacion de microprogramas del VU1 compilados: incluye el fichero generado de un trozo
+// (VU1GEN_UNIT_FILE, desde el microcodigo del disco del usuario; no se versiona) junto con los cuerpos de las
+// instrucciones (ps2_vu1_upper.cpp / ps2_vu1_lower.cpp, plantillas en linea) y el paso de un par (ps2_vu1_step.inc).
+// Cada `case` generado es el paso del interprete con el par de instrucciones y su decodificacion como constantes de
+// compilacion, asi que el resultado (estado, ciclos, banderas, XGKICK) es el del interprete por construccion. Si el
+// microcodigo del par no coincide con el generado, o el PC sale del trozo, se devuelve el control al interprete.
+#define VU1_GEN_TU 1
+#include "ps2_vu1_upper.cpp"
+#include "ps2_vu1_lower.cpp"
+#include "ps2_vu1_genapi.h"
+
+#include <algorithm>
+#include <bit>
+
+#include "ps2_vu1_step.inc"
+
+// Un trozo: VU1GEN_CHUNK_BEGIN(n, lo, hi) { VU1GEN_PAIR(pc, clave, decodificacion)... } VU1GEN_CHUNK_END
+// La clave es el par de 8 bytes tal cual esta en el microcodigo (inferior | superior << 32): se compara en cada par.
+// Un `case` puede tener varias variantes (VU1GEN_PAIR_V) si el juego carga imagenes distintas en ese par.
+#define VU1GEN_CHUNK_BEGIN(N, LO, HI)                                                                             \
+    template <>                                                                                                   \
+    int VU1Gen::chunk<N>(VU1Interpreter & vu, uint8_t * vuCode, uint8_t * vuData, uint32_t dataSize, GS & gs,     \
+                         PS2Memory * memory, uint32_t codeSize, uint64_t budgetEnd, bool &programEnded)           \
+    {                                                                                                             \
+        for (;;)                                                                                                  \
+        {                                                                                                         \
+            if (!(vu.m_cycle < budgetEnd) || vu.m_stopRequested || vu.m_state.pc + 8u > codeSize)                 \
+                return kVu1GenStop;                                                                               \
+            if (vu.m_state.pc - (LO) >= (HI) - (LO))                                                              \
+                return kVu1GenLeft;                                                                               \
+            uint64_t word_;                                                                                       \
+            __builtin_memcpy(&word_, vuCode + vu.m_state.pc, 8);                                                  \
+            switch (vu.m_state.pc)                                                                                \
+            {
+#define VU1GEN_VARIANT(KEY, ...)                                                                                  \
+    if (word_ == (KEY))                                                                                           \
+    {                                                                                                             \
+        static constexpr VU1Interpreter::DecodedInstructionPair d = __VA_ARGS__;                                  \
+        if (!vu.stepPairT<true>(d, vuCode, vuData, dataSize, gs, memory, codeSize, budgetEnd, programEnded))      \
+            return kVu1GenStop;                                                                                   \
+        break;                                                                                                    \
+    }
+#define VU1GEN_PAIR_BEGIN(PC) case PC: {
+#define VU1GEN_PAIR_END                                                                                           \
+    return kVu1GenMismatch;                                                                                       \
+    }
+#define VU1GEN_CHUNK_END                                                                                          \
+    default:                                                                                                      \
+        return kVu1GenMismatch;                                                                                   \
+    }                                                                                                             \
+    }                                                                                                             \
+    }
+
+#include VU1GEN_UNIT_FILE
diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_genapi.h b/ps2xRuntime/src/lib/vu/ps2_vu1_genapi.h
new file mode 100644
index 0000000..a5a966b
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_genapi.h
@@ -0,0 +1,61 @@
+// Interfaz entre el interprete del VU1 y los microprogramas compilados (ps2_vu1_gen*.cpp). El codigo compilado
+// se genera desde el microcodigo del disco del usuario (BLADE_VU1_GEN, ver README) y NO se versiona; este
+// fichero, el generador y el interprete si.
+#ifndef PS2_VU1_GENAPI_H
+#define PS2_VU1_GENAPI_H
+
+#include <cstddef>
+#include <cstdint>
+
+class GS;
+class PS2Memory;
+class VU1Interpreter;
+
+// Resultado de ejecutar un trozo compilado
+enum VU1GenResult : int
+{
+    kVu1GenStop = 0,     // fin de la llamada (presupuesto agotado, programa terminado o parada): salir del bucle
+    kVu1GenLeft = 1,     // el PC salio del trozo: volver a elegir trozo
+    kVu1GenMismatch = 2, // el microcodigo en el PC no es el generado: ejecutar ese par con el interprete
+};
+
+using VU1GenChunkFn = int (*)(VU1Interpreter &, uint8_t *vuCode, uint8_t *vuData, uint32_t dataSize, GS &, PS2Memory *,
+                              uint32_t codeSize, uint64_t budgetEnd, bool &programEnded);
+
+// Los trozos son especializaciones de esta plantilla (amiga del interprete para acceder a su estado).
+struct VU1Gen
+{
+    template <int N>
+    static int chunk(VU1Interpreter &, uint8_t *vuCode, uint8_t *vuData, uint32_t dataSize, GS &, PS2Memory *,
+                     uint32_t codeSize, uint64_t budgetEnd, bool &programEnded);
+};
+
+// Trozos de microcodigo compilados: el trozo i cubre los bytes [i << chunkShift, (i + 1) << chunkShift).
+struct VU1GenProgram
+{
+    uint32_t chunkShift;
+    uint32_t chunkCount;
+    const VU1GenChunkFn *chunks; // nullptr = sin trozo compilado (lo ejecuta el interprete)
+};
+
+// Hash FNV-1a de 64 bits por palabras de 8 bytes de [lo, hi) (solo informativo en el generador).
+inline uint64_t vu1GenHash(const uint8_t *code, uint32_t lo, uint32_t hi)
+{
+    uint64_t h = 1469598103934665603ull;
+    for (uint32_t i = lo; i + 8u <= hi; i += 8u)
+    {
+        uint64_t w;
+        __builtin_memcpy(&w, code + i, 8);
+        h = (h ^ w) * 1099511628211ull;
+    }
+    return h;
+}
+
+// Pares ejecutados por el interprete dentro de un programa compilado (el PC salio de lo generado o el microcodigo
+// no coincidia); se muestra al final de BLADE_VU1_REPLAY.
+extern uint64_t g_vu1GenFallback;
+
+// Definida en ps2_vu1_gen.cpp con la tabla generada; nullptr si no se genero nada.
+const VU1GenProgram *vu1GenProgram();
+
+#endif
