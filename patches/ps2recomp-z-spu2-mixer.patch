+    void IopMemory::spuReverbFrame(uint32_t core, int32_t wetL, int32_t wetR, int32_t &outL, int32_t &outR) const
+    {
+        SpuReverb &r = m_spuRev[core];
+        const uint32_t base = Spu2Base + core * kSpuCoreStride;
+        for (int k = 38; k > 0; --k)
+        {
+            r.inL[k] = r.inL[k - 1];
+            r.inR[k] = r.inR[k - 1];
+        }
+        r.inL[0] = sat16(wetL);
+        r.inR[0] = sat16(wetR);
+        ++r.frame;
+        bool stepped = false;
+        if ((r.frame & 1u) == 0u)
+        {
+            stepped = true;
+            const uint32_t esa = (((static_cast<uint32_t>(spuReg(base + 0x2E0u)) & 0xFu) << 16u) | spuReg(base + 0x2E2u)) & 0xFFFFFu;
+            const uint32_t eea = ((static_cast<uint32_t>(spuReg(base + 0x33Cu)) & 0xFu) << 16u) | 0xFFFFu;
+            const uint32_t size = eea >= esa ? eea - esa + 1u : 1u;
+            uint32_t R[22];
+            for (uint32_t i = 0; i < 22u; ++i)
+                R[i] = (static_cast<uint32_t>(spuReg(base + 0x2E4u + i * 4u)) << 16u) | spuReg(base + 0x2E6u + i * 4u);
+            const uint32_t vb = Spu2Base + 0x760u + core * 0x28u + 0x14u;
+            const auto vol = [&](uint32_t i) { return static_cast<int32_t>(static_cast<int16_t>(spuReg(vb + i * 2u))); };
+            const int32_t vIIR = vol(0), vC1 = vol(1), vC2 = vol(2), vC3 = vol(3), vC4 = vol(4), vWALL = vol(5), vAPF1 = vol(6),
+                          vAPF2 = vol(7), vLIN = vol(8), vRIN = vol(9);
+            const auto addr = [&](int64_t reg, int64_t delta)
+            {
+                int64_t off = (reg + r.pos + delta) % static_cast<int64_t>(size);
+                if (off < 0)
+                    off += size;
+                return ((esa + static_cast<uint32_t>(off)) & 0xFFFFFu) * 2u;
+            };
+            const auto rd = [&](uint32_t a) { int16_t v; std::memcpy(&v, &m_spuRam[a % kSpuRamBytes], 2); return static_cast<int32_t>(v); };
+            const auto wr = [&](uint32_t a, int32_t v) { const int16_t s = static_cast<int16_t>(sat16(v)); std::memcpy(&m_spuRam[a % kSpuRamBytes], &s, 2); };
+            const int32_t Lin = (fir39(r.inL) * vLIN) >> 15, Rin = (fir39(r.inR) * vRIN) >> 15;
+            const auto iir = [&](int64_t m, int64_t d, int32_t in)
+            {
+                const int32_t prev = rd(addr(m, -1));
+                wr(addr(m, 0), (((in + ((rd(addr(d, 0)) * vWALL) >> 15) - prev) * vIIR) >> 15) + prev);
+            };
+            iir(R[2], R[8], Lin);   // misma banda: mLSAME <- dLSAME
+            iir(R[3], R[9], Rin);   // mRSAME <- dRSAME
+            iir(R[10], R[17], Lin); // banda cruzada: mLDIFF <- dRDIFF
+            iir(R[11], R[16], Rin); // mRDIFF <- dLDIFF
+            int32_t lo = (vC1 * rd(addr(R[4], 0)) + vC2 * rd(addr(R[6], 0)) + vC3 * rd(addr(R[12], 0)) + vC4 * rd(addr(R[14], 0))) >> 15;
+            int32_t ro = (vC1 * rd(addr(R[5], 0)) + vC2 * rd(addr(R[7], 0)) + vC3 * rd(addr(R[13], 0)) + vC4 * rd(addr(R[15], 0))) >> 15;
+            const auto apf = [&](int32_t x, int64_t m, int64_t d, int32_t v)
+            {
+                const int32_t delayed = rd(addr(m - d, 0));
+                x = sat16(x - ((v * delayed) >> 15));
+                wr(addr(m, 0), x);
+                return sat16(((x * v) >> 15) + delayed);
+            };
+            lo = apf(lo, R[18], R[0], vAPF1);
+            ro = apf(ro, R[19], R[0], vAPF1);
+            lo = apf(lo, R[20], R[1], vAPF2);
+            ro = apf(ro, R[21], R[1], vAPF2);
+            r.stepL = sat16(lo);
+            r.stepR = sat16(ro);
+            r.pos = (r.pos + 1u) % size;
+        }
+        for (int k = 38; k > 0; --k)
