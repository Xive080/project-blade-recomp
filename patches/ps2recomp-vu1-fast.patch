+bool VU1Interpreter::fastFmacFlags(const float *result, uint8_t dest, uint8_t laneFlags[4], uint32_t &extraSticky) const
+{
+    // Camino rapido de normalizeFmacResult + calculateFmacProductSticky. Con operandos y resultado
+    // en rango, el calculo exacto (long double) no puede dar cero, desbordamiento ni subdesbordamiento
+    // y su signo es el del resultado en float: la unica bandera es S y el valor no cambia. En otro
+    // caso se devuelve false y se usa el calculo exacto de siempre.
+    const uint32_t upper = m_currentUpperInstruction;
+    const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+    const uint8_t code = op >= 0x3Cu ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu)) : op;
+    const bool special = op >= 0x3Cu;
+    const float *vs = m_state.vf[FS(upper)];
+    const float *vt = m_state.vf[FT(upper)];
+
+    enum : uint8_t { SrcBc, SrcQ, SrcI, SrcVec, SrcCross } src;
+    bool usesAcc = false;
+    if (code <= 0x0Fu)
+    {
+        src = SrcBc;
+        usesAcc = code >= 0x08u;
+    }
+    else if (code >= 0x18u && code <= 0x1Bu)
+        src = SrcBc;
+    else
+    {
+        switch (code)
+        {
+        case 0x1Cu: case 0x20u: case 0x24u: src = SrcQ; break;
+        case 0x21u: case 0x25u: src = SrcQ; usesAcc = true; break;
+        case 0x1Eu: case 0x22u: case 0x26u: src = SrcI; break;
+        case 0x23u: case 0x27u: src = SrcI; usesAcc = true; break;
+        case 0x28u: case 0x2Au: case 0x2Cu: src = SrcVec; break;
+        case 0x29u: case 0x2Du: src = SrcVec; usesAcc = true; break;
+        case 0x2Eu: src = SrcCross; usesAcc = !special; break;
+        default: return false;
+        }
+    }
+
+    static constexpr uint8_t crossLeft[4] = {1u, 2u, 0u, 3u};
+    static constexpr uint8_t crossRight[4] = {2u, 0u, 1u, 3u};
+    uint8_t flags[4] = {0u, 0u, 0u, 0u};
+    uint32_t sticky = 0u;
+    for (uint32_t component = 0; component < 4u; ++component)
+    {
+        if ((dest & laneForComponent(component)) == 0u)
+            continue;
+        float a = 0.0f;
+        float b = 0.0f;
+        switch (src)
+        {
+        case SrcBc: a = vs[component]; b = vt[code & 3u]; break;
+        case SrcQ: a = vs[component]; b = m_state.q; break;
+        case SrcI: a = vs[component]; b = m_state.i; break;
+        case SrcVec: a = vs[component]; b = vt[component]; break;
+        case SrcCross:
+            if (component == 3u)
+                return false;
+            a = vs[crossLeft[component]];
+            b = vt[crossRight[component]];
+            break;
+        }
+        a = normalizeOperand(a);
+        b = normalizeOperand(b);
+        if (!fmacOperandSafe(a) || !fmacOperandSafe(b))
+            return false;
+        uint32_t resultBits = 0;
+        std::memcpy(&resultBits, &result[component], sizeof(resultBits));
+        const bool zeroResult = (resultBits & 0x7FFFFFFFu) == 0u;
+        if (!zeroResult && !fmacResultSafe(result[component]))
+            return false;
+        if (usesAcc)
+        {
+            if (!fmacOperandSafe(normalizeOperand(m_state.acc[component])))
+                return false;
+            // Resultado cero en MADD/MSUB: solo es seguro si el producto en float es exacto (entonces el
+            // calculo exacto tambien da cero, con el mismo signo).
+            if (zeroResult && static_cast<double>(a * b) != static_cast<double>(a) * static_cast<double>(b))
+                return false;
+            // Banderas del producto (pegajosas): Z si algun factor es cero, S por el signo.
+            if ((a == 0.0f) || (b == 0.0f))
+                sticky |= 0x1u;
+            if ((signOf(a) ^ signOf(b)) != 0u)
+                sticky |= 0x2u;
+        }
+        // Cero: sumas, restas y productos de operandos en rango solo dan cero si el resultado exacto es
+        // cero, con el mismo signo (mismo modo de redondeo): banderas Z y S como en el calculo exacto.
+        flags[component] = static_cast<uint8_t>((signOf(result[component]) != 0u ? 0x2u : 0x0u) | (zeroResult ? 0x1u : 0x0u));
+    }
+    std::memcpy(laneFlags, flags, sizeof(flags));
+    extraSticky = sticky;
+    return true;
 }
 
