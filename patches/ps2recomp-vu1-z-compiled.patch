diff --git a/ps2xRuntime/src/lib/vu/ps2_vu1_step.inc b/ps2xRuntime/src/lib/vu/ps2_vu1_step.inc
new file mode 100644
index 0000000..e3732f5
--- /dev/null
+++ b/ps2xRuntime/src/lib/vu/ps2_vu1_step.inc
@@ -0,0 +1,161 @@
+// Un par de instrucciones: el cuerpo del bucle de VU1Interpreter::run(), compartido por el interprete
+// (Gen=false, par decodificado en cache) y por los microprogramas compilados (Gen=true, `decoded` es una
+// constante de compilacion generada por el decodificador del propio interprete). Misma logica, mismo orden, mismos
+// ciclos: solo cambia que el compilador resuelve lo que es constante.
+// Incluido por ps2_vu1_core.cpp y por ps2_vu1_gen.cpp.
+#ifndef PS2_VU1_STEP_INC
+#define PS2_VU1_STEP_INC
+
+#define EXEC_UPPER(x) do { if constexpr (Gen) execUpperT<true>(x); else execUpper(x); } while (0)
+#define EXEC_LOWER(x) do { if constexpr (Gen) execLowerT<true>(x, vuData, dataSize, gs, memory, decoded.upper); else execLower(x, vuData, dataSize, gs, memory, decoded.upper); } while (0)
+
+template <bool Gen>
+__attribute__((always_inline)) inline bool VU1Interpreter::stepPairT(const DecodedInstructionPair &decoded, uint8_t *vuCode, uint8_t *vuData, uint32_t dataSize,
+                               GS &gs, PS2Memory *memory, uint32_t codeSize, uint64_t budgetEnd, bool &programEnded)
+{
+    (void)vuCode;
+    (void)codeSize;
+    if constexpr (!Gen)
+    {
+        if (decoded.upperUsage.reserved || decoded.lowerUsage.reserved)
+        {
+            reportReservedInstruction(decoded.upperUsage.reserved, decoded.upperUsage.reserved ? decoded.upper : decoded.lower);
+            return false;
+        }
+    }
+
+    uint64_t readyCycle = calculatePairReadyCycle(decoded);
+    while (readyCycle > m_cycle)
+    {
+        if (readyCycle >= budgetEnd)
+        {
+            advanceTo(budgetEnd);
+            break;
+        }
+        advanceTo(readyCycle);
+        readyCycle = calculatePairReadyCycle(decoded);
+    }
+    if (m_cycle >= budgetEnd)
+        return false;
+
+    uint8_t writtenVi = 0u;
+    int32_t oldVi = 0;
+    if (const uint32_t viBits = decoded.lowerUsage.viWrite & 0xFFFEu; viBits != 0u)
+    {
+        writtenVi = static_cast<uint8_t>(std::countr_zero(viBits));
+        oldVi = m_state.vi[writtenVi];
+    }
+
+    if (decoded.iBit)
+    {
+        EXEC_UPPER(decoded.upper);
+        float immediate = 0.0f;
+        std::memcpy(&immediate, &decoded.lower, sizeof(immediate));
+        m_state.i = normalizeOperand(immediate);
+    }
+    else if (decoded.upperVfShadowReg != 0u)
+    {
+        float oldVf[4]{};
+        float upperVf[4]{};
+        std::memcpy(oldVf,
+                    m_state.vf[decoded.upperVfShadowReg],
+                    sizeof(oldVf));
+        EXEC_UPPER(decoded.upper);
+        std::memcpy(upperVf,
+                    m_state.vf[decoded.upperVfShadowReg],
+                    sizeof(upperVf));
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg],
+                    oldVf,
+                    sizeof(oldVf));
+        EXEC_LOWER(decoded.lower);
+        std::memcpy(m_state.vf[decoded.upperVfShadowReg],
+                    upperVf,
+                    sizeof(upperVf));
+    }
+    else
+    {
+        EXEC_UPPER(decoded.upper);
+        EXEC_LOWER(decoded.lower);
+    }
+
+    m_viBranchBackupValid = false;
+
+    // Las escrituras de VF/VI/ACC se hacen en el acto: toda lectura de esos registros espera
+    // (calculatePairReadyCycle) a que la escritura sea visible, asi que el resultado es el mismo
+    // que retenerlas en una cola hasta su ciclo. Solo se guarda hasta cuando seguirian pendientes
+    // para que flushPipelines avance los mismos ciclos.
+    if (writtenVi != 0u)
+    {
+        m_state.vi[writtenVi] = static_cast<int16_t>(m_state.vi[writtenVi]);
+        noteEagerWrite(decoded.lowerUsage.viLatency != 0u ? decoded.lowerUsage.viLatency : decoded.lowerUsage.latency);
+    }
+    if (decoded.upperUsage.vfWrite.reg != 0u)
+        noteEagerWrite(decoded.upperUsage.vfLatency != 0u ? decoded.upperUsage.vfLatency : decoded.upperUsage.latency);
+    if (decoded.lowerUsage.vfWrite.reg != 0u && decoded.suppressedLowerVf != decoded.lowerUsage.vfWrite.reg)
+        noteEagerWrite(decoded.lowerUsage.vfLatency != 0u ? decoded.lowerUsage.vfLatency : decoded.lowerUsage.latency);
+    if (decoded.upperUsage.accWrite != 0u)
+        noteEagerWrite(kAccForwardLatency);
+
+    markPairWrites(decoded);
+    if (writtenVi != 0u && decoded.lowerUsage.delaysNextBranchRead)
+        recordViWriteForBranch(writtenVi, oldVi);
+
+    m_state.vf[0][0] = 0.0f;
+    m_state.vf[0][1] = 0.0f;
+    m_state.vf[0][2] = 0.0f;
+    m_state.vf[0][3] = 1.0f;
+    m_state.vi[0] = 0;
+
+    uint32_t nextPc = m_state.pc + 8u;
+    if (nextPc >= codeSize)
+        nextPc = 0u;
+    m_state.pc = nextPc;
+
+    if (m_state.branchPending)
+    {
+        if (m_state.branchDelay == 0u)
+        {
+            m_state.pc = m_state.branchTarget & microAddressMask();
+            m_state.branchPending = false;
+        }
+        else
+        {
+            --m_state.branchDelay;
+        }
+    }
+
+    const bool dHalt = decoded.dBit && m_state.dBitEnabled;
+    const bool tHalt = decoded.tBit && m_state.tBitEnabled;
+    const bool haltBit = dHalt || tHalt;
+    const bool haltBranch = haltBit && decoded.lowerUsage.pipeline == PipelineBranch;
+
+    if (m_state.haltAfterDelaySlot)
+    {
+        m_state.stoppedByD = m_pendingHaltD;
+        m_state.stoppedByT = m_pendingHaltT;
+        programEnded = true;
+    }
+    else if (m_state.ebit)
+        programEnded = true;
+    else if (haltBit && !haltBranch)
+    {
+        m_state.stoppedByD = dHalt;
+        m_state.stoppedByT = tHalt;
+        programEnded = true;
+    }
+    else if (decoded.eBit)
+        m_state.ebit = true;
+    else if (haltBranch)
+    {
+        m_state.haltAfterDelaySlot = true;
+        m_pendingHaltD = dHalt;
+        m_pendingHaltT = tHalt;
+    }
+
+    advanceOneCycle();
+    return !programEnded;
+}
+
+#undef EXEC_UPPER
+#undef EXEC_LOWER
+#endif
