+        {
+            int64_t acc = 0;
+            for (int k = 0; k < 39; ++k)
+                acc += static_cast<int64_t>(kRevFir[k]) * x[k];
+            return sat16(static_cast<int32_t>(acc >> 15));
+        }
+    }
