+    const char *const kG0CauseName[12] = {
+        "fin de la llamada SubmitMany (no hay mas primitivas)", "cambia FBP", "cambia FBW", "cambia PSM del FRAME", "cambia ZBP", "cambia PSM del ZBUF",
+        "cambia uso de Z", "cambia scissor.y1", "la textura de la siguiente solapa destino (rangos)", "textura previa del tramo solapa destino (fila nueva)",
+        "otro", ""};
+
+    // Por que acabo el tramo [first, j): j es el indice de la primitiva que lo corta (o count)
+    int g0Cause(const GSPrimitiveBatch *const *batches, size_t first, size_t j, size_t count)
+    {
+        while (j < count && batches[j]->vertexCount == 0u)
+            ++j;
+        if (j >= count)
+            return 0;
+        const auto &a = batches[first]->state.context;
+        const auto &bs = batches[j]->state;
+        const auto &b = bs.context;
+        if (a.frame.fbp != b.frame.fbp) return 1;
+        if (a.frame.fbw != b.frame.fbw) return 2;
+        if (a.frame.psm != b.frame.psm) return 3;
+        if (a.zbuf.zbp != b.zbuf.zbp) return 4;
+        if (a.zbuf.psm != b.zbuf.psm) return 5;
+        if (zbufferUsed(a) != zbufferUsed(b)) return 6;
+        if (a.scissor.y1 != b.scissor.y1) return 7;
+        if (bs.prim.tme) return 8;
+        return 9;
+    }
+
+    bool g0Active()
+    {
+        if (!g_g0.on)
+            return false;
+        const uint32_t p = g_g0Present.load(std::memory_order_relaxed);
+        return p >= g_g0.from && p < g_g0.to;
+    }
