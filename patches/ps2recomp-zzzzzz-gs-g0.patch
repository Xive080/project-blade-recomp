+// ---- G0 (instrumentacion, apagada): clasificacion de las primitivas que SubmitManyImpl dibuja en serie por "textura solapa
+// destino". PS2X_GS_G0=desde,hasta (indices de Present). Calcula, por primitiva, los BLOQUES de 256 B de la VRAM que
+// realmente lee (rectangulo UV con margen de 1 texel, direcciones de swizzle exactas) y que realmente escribe (rectangulo
+// XY recortado al scissor, mas ZBUF si se usa), y los compara con el criterio de intervalos de paginas de hoy. Ademas
+// simula el reparto en tramos con la prueba exacta (bloques leidos frente a escritos) para saber cuantas primitivas
+// pasarian de serie a paralelo. No cambia el dibujo ni el reparto real. ----
+#include <bitset>
+#include <map>
+#include <mutex>
+#include <string>
+namespace
+{
+    struct G0Window { uint32_t from = 0, to = 0xFFFFFFFFu; bool on = false; };
+    const G0Window g_g0 = []()
+    {
+        G0Window w;
+        if (const char *e = std::getenv("PS2X_GS_G0"); e && *e && *e != '0')
+        {
+            w.on = true;
+            unsigned a = 0, b = 0xFFFFFFFFu;
+            if (std::sscanf(e, "%u,%u", &a, &b) >= 1) { w.from = a; w.to = b; }
+        }
+        return w;
+    }();
+    std::atomic<uint32_t> g_g0Present{0};
+    std::atomic<bool> g_g0Dumped{false};
+
+    using G0Blocks = std::bitset<16384>; // 4 MiB / 256 B
+
+    struct G0Stat { uint64_t n = 0, px = 0, ns = 0, rdPx = 0; };
+    struct G0State
+    {
+        std::mutex mu;
+        // reason 1 (textura solapa destino): por categoria
+        G0Stat cat[8];
+        std::map<std::string, G0Stat> groups;       // por (categoria, textura, destino)
+        std::map<std::string, std::string> groupEx; // ejemplo de rectangulos
+        G0Stat reason[3];                           // 0 destino/z solapados, 1 textura solapa destino, 2 tramo pequeno
+        G0Stat cause[12];                           // por que se corto el tramo pequeno (motivo 2)
+        G0Stat r0[2];                               // motivo 0: [0] sin bloques compartidos entre FRAME y ZBUF, [1] con bloques compartidos
+        uint64_t causeRuns[12] = {};
+        uint64_t zTrigger = 0, fTrigger = 0, bothTrigger = 0;
+        // simulacion con prueba exacta
+        uint64_t simPar = 0, simSer = 0, simParPx = 0, simSerPx = 0, simRuns = 0, totPrims = 0;
+        uint64_t presentFirst = 0, presentLast = 0, frames = 0;
+    } g_g0s;
+    const char *const kG0CatName[8] = {
+        "falso positivo: ni comparten pagina",
+        "falso positivo: comparten pagina, no bloque",
+        "real: realimentacion 1:1 en el mismo buffer",
+        "real: mismo buffer, UV desplazado/escalado",
+        "real: otro buffer, comparten bloques (copia/solape)",
+        "real: solo con el ZBUF",
+        "sin escritura: primitiva fuera del scissor", "UV sin rectangulo calculable"};
+
+    bool g0Block(uint32_t psm, uint32_t &w, uint32_t &h)
+    {
+        switch (static_cast<GSMem::PixelStorageMode>(psm & 0x3Fu))
+        {
+        case GSMem::C32: case GSMem::C24: case GSMem::Z32: case GSMem::Z24:
+        case GSMem::P8H: case GSMem::P4HL: case GSMem::P4HH: w = 8; h = 8; return true;
+        case GSMem::C16: case GSMem::C16S: case GSMem::Z16: case GSMem::Z16S: w = 16; h = 8; return true;
+        case GSMem::P8: w = 16; h = 16; return true;
+        case GSMem::P4: w = 32; h = 16; return true;
+        default: return false;
+        }
+    }
+
+    uint32_t g0ByteAddr(uint32_t psm, uint32_t bp, uint32_t bw, uint32_t x, uint32_t y)
+    {
+        using namespace GSMem;
+        const PixelStorageMode m = static_cast<PixelStorageMode>(psm & 0x3Fu);
+        uint32_t a = 0;
+        switch (m)
+        {
+        case C32: a = PixelStorageTraits<C32>::Address(PageTableC32, bp, bw, x, y); break;
+        case C24: a = PixelStorageTraits<C24>::Address(PageTableC32, bp, bw, x, y); break;
+        case C16: a = PixelStorageTraits<C16>::Address(PageTableC16, bp, bw, x, y); break;
+        case C16S: a = PixelStorageTraits<C16S>::Address(PageTableC16S, bp, bw, x, y); break;
+        case P8: a = PixelStorageTraits<P8>::Address(PageTableP8, bp, bw, x, y); break;
+        case P4: a = PixelStorageTraits<P4>::Address(PageTableP4, bp, bw, x, y); break;
+        case P8H: a = PixelStorageTraits<P8H>::Address(PageTableC32, bp, bw, x, y); break;
+        case P4HL: a = PixelStorageTraits<P4HL>::Address(PageTableC32, bp, bw, x, y); break;
+        case P4HH: a = PixelStorageTraits<P4HH>::Address(PageTableC32, bp, bw, x, y); break;
+        case Z32: a = PixelStorageTraits<Z32>::Address(PageTableZ32, bp, bw, x, y); break;
+        case Z24: a = PixelStorageTraits<Z24>::Address(PageTableZ32, bp, bw, x, y); break;
+        case Z16: a = PixelStorageTraits<Z16>::Address(PageTableZ16, bp, bw, x, y); break;
+        case Z16S: a = PixelStorageTraits<Z16S>::Address(PageTableZ16S, bp, bw, x, y); break;
+        default: return 0;
+        }
+        const uint32_t bits = a * static_cast<uint32_t>(UnpackedBitWidth(m));
+        return (bits / 8u) & (static_cast<uint32_t>(MEMORY_SIZE) - 1u);
+    }
+
+    struct G0Rect { int x0 = 0, y0 = 0, x1 = -1, y1 = -1; bool ok = false; };
+
+    // Bloques de un rectangulo de pixeles (inclusivo) de un buffer: una muestra por celda de bloque, direccion exacta
+    void g0Blocks(const G0Rect &r, uint32_t psm, uint32_t bp, uint32_t bw, G0Blocks &out)
+    {
+        uint32_t bwid = 0, bh = 0;
+        if (!r.ok || !g0Block(psm, bwid, bh))
+            return;
+        const int x0 = std::max(r.x0, 0), y0 = std::max(r.y0, 0);
+        const int x1 = std::min(r.x1, 4095), y1 = std::min(r.y1, 4095);
+        if (x1 < x0 || y1 < y0)
+            return;
+        const int cells = ((x1 / static_cast<int>(bwid)) - (x0 / static_cast<int>(bwid)) + 1) * ((y1 / static_cast<int>(bh)) - (y0 / static_cast<int>(bh)) + 1);
+        if (cells > 70000)
+            return;
+        for (int by = y0 / static_cast<int>(bh); by <= y1 / static_cast<int>(bh); ++by)
+            for (int bx = x0 / static_cast<int>(bwid); bx <= x1 / static_cast<int>(bwid); ++bx)
+            {
+                const int px = std::max(x0, bx * static_cast<int>(bwid)), py = std::max(y0, by * static_cast<int>(bh));
+                out.set((g0ByteAddr(psm, bp, bw, static_cast<uint32_t>(px), static_cast<uint32_t>(py)) >> 8) & 16383u);
+            }
+    }
+
+    G0Rect g0WriteRect(const GSPrimitiveBatch &b)
+    {
+        const auto &ctx = b.state.context;
+        const uint32_t n = std::max<uint32_t>(1u, std::min<uint32_t>(b.vertexCount, 3u));
+        float x0 = b.vertices[0].x, x1 = x0, y0 = b.vertices[0].y, y1 = y0;
+        for (uint32_t k = 1; k < n; ++k)
+        {
+            x0 = std::min(x0, b.vertices[k].x); x1 = std::max(x1, b.vertices[k].x);
+            y0 = std::min(y0, b.vertices[k].y); y1 = std::max(y1, b.vertices[k].y);
+        }
+        const int ofx = ctx.xyoffset.ofx >> 4, ofy = ctx.xyoffset.ofy >> 4;
+        G0Rect r;
+        r.x0 = std::max(static_cast<int>(std::floor(x0)) - ofx - 1, static_cast<int>(ctx.scissor.x0));
+        r.y0 = std::max(static_cast<int>(std::floor(y0)) - ofy - 1, static_cast<int>(ctx.scissor.y0));
+        r.x1 = std::min(static_cast<int>(std::ceil(x1)) - ofx + 1, static_cast<int>(ctx.scissor.x1));
+        r.y1 = std::min(static_cast<int>(std::ceil(y1)) - ofy + 1, static_cast<int>(ctx.scissor.y1));
+        r.ok = r.x1 >= r.x0 && r.y1 >= r.y0;
+        return r;
+    }
+
+    G0Rect g0ReadRect(const GSPrimitiveBatch &b)
+    {
+        const auto &st = b.state;
+        const auto &ctx = st.context;
+        const int tw = std::max<int>(st.textureWidth, 1), th = std::max<int>(st.textureHeight, 1);
+        const uint32_t n = std::max<uint32_t>(1u, std::min<uint32_t>(b.vertexCount, 3u));
+        float u0 = 1e30f, u1 = -1e30f, v0 = 1e30f, v1 = -1e30f;
+        for (uint32_t k = 0; k < n; ++k)
+        {
+            const auto &v = b.vertices[k];
+            float fu, fv;
+            if (st.prim.fst) { fu = v.u / 16.0f; fv = v.v / 16.0f; }
+            else
+            {
+                const float q = std::fabs(v.q);
+                if (q < 1e-20f) { G0Rect full; full.x0 = 0; full.y0 = 0; full.x1 = tw - 1; full.y1 = th - 1; full.ok = true; return full; }
+                fu = v.s / q * static_cast<float>(tw);
+                fv = v.t / q * static_cast<float>(th);
+            }
+            u0 = std::min(u0, fu); u1 = std::max(u1, fu); v0 = std::min(v0, fv); v1 = std::max(v1, fv);
+        }
+        const uint64_t cl = ctx.clamp;
+        const uint32_t wu = static_cast<uint32_t>(cl & 3u), wv = static_cast<uint32_t>((cl >> 2) & 3u);
+        const int minU = static_cast<int>((cl >> 4) & 0x3FF), maxU = static_cast<int>((cl >> 14) & 0x3FF);
+        const int minV = static_cast<int>((cl >> 24) & 0x3FF), maxV = static_cast<int>((cl >> 34) & 0x3FF);
+        G0Rect r;
+        auto axis = [](float lo, float hi, int size, uint32_t mode, int rmin, int rmax, int &a, int &bb)
+        {
+            a = static_cast<int>(std::floor(lo)) - 1;
+            bb = static_cast<int>(std::ceil(hi)) + 1;
+            const bool inside = a >= 0 && bb <= size - 1;
+            if (mode == 1u) { a = std::min(std::max(a, 0), size - 1); bb = std::min(std::max(bb, 0), size - 1); }
+            else if (mode == 2u) { a = std::min(std::max(a, rmin), rmax); bb = std::min(std::max(bb, rmin), rmax); }
+            else if (!inside) { a = 0; bb = (mode == 3u ? 1023 : size - 1); } // repeat: la textura entera (conservador)
+        };
+        axis(u0, u1, tw, wu, minU, maxU, r.x0, r.x1);
+        axis(v0, v1, th, wv, minV, maxV, r.y0, r.y1);
+        r.ok = r.x1 >= r.x0 && r.y1 >= r.y0;
+        return r;
+    }
+
+    struct G0Info
+    {
+        G0Rect wr, rd;
+        G0Blocks frame, z, read;
+        bool zUsed = false, tme = false;
+    };
+
+    void g0Compute(const GSPrimitiveBatch &b, G0Info &o)
+    {
+        const auto &ctx = b.state.context;
+        o.frame.reset(); o.z.reset(); o.read.reset();
+        o.tme = b.state.prim.tme;
+        o.zUsed = zbufferUsed(ctx);
+        o.wr = g0WriteRect(b);
+        g0Blocks(o.wr, ctx.frame.psm, GSInternal::framePageBaseToBlock(ctx.frame.fbp), std::max<uint32_t>(ctx.frame.fbw, 1u), o.frame);
+        if (o.zUsed)
+            g0Blocks(o.wr, ctx.zbuf.psm, GSInternal::framePageBaseToBlock(ctx.zbuf.zbp), std::max<uint32_t>(ctx.frame.fbw, 1u), o.z);
+        if (o.tme)
+        {
+            o.rd = g0ReadRect(b);
+            g0Blocks(o.rd, ctx.tex0.psm, ctx.tex0.tbp0, std::max<uint32_t>(ctx.tex0.tbw, 1u), o.read);
+        }
+    }
+
+    G0Blocks g0Pages(const G0Blocks &bl)
+    {
+        G0Blocks p;
+        for (size_t i = 0; i < bl.size(); ++i)
+            if (bl.test(i)) { for (size_t k = 0; k < 32; ++k) p.set((i / 32) * 32 + k); }
+        return p;
+    }
+
+    // Categoria de una primitiva en serie por "textura solapa destino"
+    int g0Classify(const GSPrimitiveBatch &b, const G0Info &o)
+    {
+        const auto &ctx = b.state.context;
+        if (!o.wr.ok)
+            return 6;
+        if (!o.rd.ok)
+            return 7;
+        const bool ovF = (o.read & o.frame).any();
+        const bool ovZ = (o.read & o.z).any();
+        if (!ovF && !ovZ)
+            return (g0Pages(o.read) & g0Pages(o.frame | o.z)).any() ? 1 : 0;
+        if (!ovF && ovZ)
+            return 5;
+        const uint32_t fb = GSInternal::framePageBaseToBlock(ctx.frame.fbp);
+        const bool sameBuf = ctx.tex0.tbp0 == fb;
+        if (!sameBuf)
+            return 4;
+        const int dx = (o.rd.x0 + 1) - o.wr.x0 - 1, dy = (o.rd.y0 + 1) - o.wr.y0 - 1; // sin margenes de lectura/escritura
+        const int sw = (o.rd.x1 - o.rd.x0 - 2) - (o.wr.x1 - o.wr.x0 - 2), sh = (o.rd.y1 - o.rd.y0 - 2) - (o.wr.y1 - o.wr.y0 - 2);
+        const bool sameFmt = (ctx.tex0.psm & 0x0Fu) == (ctx.frame.psm & 0x0Fu) || ((ctx.tex0.psm & 3u) == (ctx.frame.psm & 3u));
+        if (sameFmt && std::abs(dx) <= 2 && std::abs(dy) <= 2 && std::abs(sw) <= 2 && std::abs(sh) <= 2)
+            return 2;
+        return 3;
     }
