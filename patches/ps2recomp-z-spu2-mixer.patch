+    void IopMemory::spuDecodeBlock(SpuVoice &voice) const
+    {
+        const uint8_t *block = m_spuRam.data() + (voice.nax % kSpuRamBytes & ~15u);
+        voice.win[0] = voice.win[28];
+        voice.win[1] = voice.win[29];
+        voice.win[2] = voice.win[30];
+        spu2::decodeAdpcmBlock(block, voice.adpcm, voice.win.data() + 3);
+        if ((block[1] & spu2::kFlagLoopStart) != 0u && !voice.lsaxSet)
+            voice.lsax = voice.nax;
+    }
