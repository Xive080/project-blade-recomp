diff --git a/ps2xIOP/src/emulator/core/spu2_dsp.h b/ps2xIOP/src/emulator/core/spu2_dsp.h
new file mode 100644
index 0000000..5857d10
--- /dev/null
+++ b/ps2xIOP/src/emulator/core/spu2_dsp.h
@@ -0,0 +1,155 @@
+#pragma once
+
+// DSP del SPU2 sin dependencias del resto del IOP (para poder probarlo aislado):
+// decodificador ADPCM de 16 bytes/28 muestras, envolvente ADSR, interpolacion y volumenes.
+#include <algorithm>
+#include <array>
+#include <cstdint>
+
+namespace ps2x::iop::spu2
+{
+    // ---- ADPCM ----
+    // Bloque de 16 bytes: byte 0 = (filtro << 4) | desplazamiento, byte 1 = banderas, 14 bytes = 28 nibbles (el bajo primero).
+    // Banderas: bit0 fin de bucle (ENDX), bit1 repetir (saltar a LSAX), bit2 inicio de bucle (fija LSAX).
+    constexpr uint8_t kFlagEnd = 0x01;
+    constexpr uint8_t kFlagRepeat = 0x02;
+    constexpr uint8_t kFlagLoopStart = 0x04;
+    constexpr int kSamplesPerBlock = 28;
+
+    // Coeficientes /64 de los filtros 0..4 (valores de la documentacion del SPU: nocash psx-spx y PCSX2).
+    constexpr int kFilter0[5] = {0, 60, 115, 98, 122};
+    constexpr int kFilter1[5] = {0, 0, -52, -55, -60};
+
+    struct AdpcmState
+    {
+        int32_t s1 = 0; // muestra anterior
+        int32_t s2 = 0; // la anterior a esa
+    };
+
+    inline int16_t clamp16(int32_t v)
+    {
+        return static_cast<int16_t>(std::clamp<int32_t>(v, -32768, 32767));
+    }
+
+    inline void decodeAdpcmBlock(const uint8_t *block, AdpcmState &st, int16_t *out)
+    {
+        const int shift = block[0] & 0x0F;
+        const int filter = std::min((block[0] >> 4) & 0x0F, 4);
+        const int f0 = kFilter0[filter];
+        const int f1 = kFilter1[filter];
+        for (int i = 0; i < kSamplesPerBlock; ++i)
+        {
+            const uint8_t byte = block[2 + i / 2];
+            const int nibble = (i & 1) ? (byte >> 4) : (byte & 0x0F);
+            const int32_t raw = static_cast<int16_t>(static_cast<uint16_t>(nibble << 12)) >> shift;
+            const int32_t predicted = (st.s1 * f0 + st.s2 * f1 + 32) >> 6;
+            const int16_t sample = clamp16(raw + predicted);
+            st.s2 = st.s1;
+            st.s1 = sample;
+            out[i] = sample;
+        }
+    }
+
+    // ---- Envolvente ADSR ----
+    enum class EnvPhase : uint8_t { Attack, Decay, Sustain, Release, Off };
+
+    struct Envelope
+    {
+        EnvPhase phase = EnvPhase::Off;
+        int32_t level = 0;   // 0..0x7FFF
+        int32_t counter = 1; // muestras que faltan para el proximo paso
+    };
+
+    struct EnvRate
+    {
+        bool decrease;
+        bool exponential;
+        int shift;
+        int step; // 0..7 para subir (suma 7-step), 0..3 para bajar (suma -8+step); se pasa ya como valor con signo
+    };
+
+    // adsr1 = registro +6 de la voz, adsr2 = registro +8
+    inline EnvRate envelopeRate(EnvPhase phase, uint16_t adsr1, uint16_t adsr2)
+    {
+        switch (phase)
+        {
+        case EnvPhase::Attack:
+            return {false, (adsr1 & 0x8000) != 0, (adsr1 >> 10) & 0x1F, 7 - ((adsr1 >> 8) & 3)};
+        case EnvPhase::Decay:
+            return {true, true, (adsr1 >> 4) & 0x0F, -8};
+        case EnvPhase::Sustain:
+        {
+            const bool dec = (adsr2 & 0x4000) != 0;
+            const int raw = (adsr2 >> 6) & 3;
+            return {dec, (adsr2 & 0x8000) != 0, (adsr2 >> 8) & 0x1F, dec ? -8 + raw : 7 - raw};
+        }
+        default: // Release
+            return {true, (adsr2 & 0x20) != 0, adsr2 & 0x1F, -8};
+        }
+    }
+
+    inline int32_t sustainLevel(uint16_t adsr1)
+    {
+        return ((adsr1 & 0x0F) + 1) * 0x800;
+    }
+
+    inline void envelopeKeyOn(Envelope &e)
+    {
+        e.phase = EnvPhase::Attack;
+        e.level = 0;
+        e.counter = 1;
+    }
+
+    inline void envelopeKeyOff(Envelope &e)
+    {
+        if (e.phase != EnvPhase::Off)
+        {
+            e.phase = EnvPhase::Release;
+            e.counter = 1;
+        }
+    }
+
+    // Avanza la envolvente una muestra (48 kHz). Devuelve el nivel actual (0..0x7FFF).
+    inline int32_t envelopeTick(Envelope &e, uint16_t adsr1, uint16_t adsr2)
+    {
+        if (e.phase == EnvPhase::Off)
+            return 0;
+        const EnvRate r = envelopeRate(e.phase, adsr1, adsr2);
+        if (--e.counter <= 0)
+        {
+            int64_t cycles = 1ll << std::max(0, r.shift - 11);
+            int32_t step = r.step * (1 << std::max(0, 11 - r.shift));
+            if (r.exponential && !r.decrease && e.level > 0x6000)
+                cycles *= 4;
+            if (r.exponential && r.decrease)
+                step = (step * e.level) >> 15;
+            e.counter = static_cast<int32_t>(std::min<int64_t>(cycles, 0x7FFFFFFF));
+            e.level = std::clamp(e.level + step, 0, 0x7FFF);
+        }
+        if (e.phase == EnvPhase::Attack && e.level >= 0x7FFF)
+            e.phase = EnvPhase::Decay;
+        if (e.phase == EnvPhase::Decay && e.level <= sustainLevel(adsr1))
+            e.phase = EnvPhase::Sustain;
+        if (e.phase == EnvPhase::Release && e.level <= 0)
+            e.phase = EnvPhase::Off;
+        return e.level;
+    }
+
+    // ---- Interpolacion (cubica de Catmull-Rom con 4 muestras; el SPU2 usa Gauss, ver README) ----
+    // t en 0..4095 (fraccion de 12 bits entre b y c).
+    inline int32_t interpolate(int32_t a, int32_t b, int32_t c, int32_t d, int32_t t)
+    {
+        const int64_t t1 = t;                 // 12 bits
+        const int64_t t2 = (t1 * t1) >> 12;
+        const int64_t t3 = (t2 * t1) >> 12;
+        const int64_t v = (2 * static_cast<int64_t>(b) << 12) + ((-a + c) * t1) + ((2 * a - 5 * b + 4 * c - d) * t2) + ((-a + 3 * b - 3 * c + d) * t3);
+        return static_cast<int32_t>(v >> 13);
+    }
+
+    // Volumen de voz/maestro en modo fijo: bit 15 = 0, los bits 0..14 son un entero de 15 bits con signo (bit 14 = signo)
+    // equivalente a (reg << 1) como int16. Devuelve -0x8000..0x7FFE (escala 0x8000 = 1,0).
+    inline int32_t fixedVolume(uint16_t reg)
+    {
+        return static_cast<int16_t>(static_cast<uint16_t>(reg << 1));
+    }
+}
