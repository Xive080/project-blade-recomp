+void PS2Memory::setIpuInputCapture(bool enabled)
+{
+    std::lock_guard<std::mutex> lock(m_ipuInputMutex);
+    m_ipuInputCapture = enabled;
+    if (!enabled)
+        m_ipuInput.clear();
+}
+
+size_t PS2Memory::takeIpuInput(std::vector<uint8_t> &out)
+{
+    std::lock_guard<std::mutex> lock(m_ipuInputMutex);
+    out.clear();
+    out.swap(m_ipuInput);
+    return out.size();
+}
+
+void PS2Memory::clearIpuInput()
+{
+    std::lock_guard<std::mutex> lock(m_ipuInputMutex);
+    m_ipuInput.clear();
+}
