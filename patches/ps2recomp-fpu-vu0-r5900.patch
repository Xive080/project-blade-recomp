--- a/ps2xRuntime/include/ps2_runtime_macros.h
+++ b/ps2xRuntime/include/ps2_runtime_macros.h
@@ -311,6 +311,37 @@ inline float ps2_frsqrt(float a, float b)
     return ps2_fall_normal(a, b, r) ? r : ps2_frsqrt_slow(a, b);
 }
 
+// VU0 macro DIV/SQRT/RSQRT (Q register). Same arithmetic as the FPU: denormals are zero, a zero divisor gives +-max
+// with the sign of fs xor ft, the root ignores the sign of ft. 0/0 in RSQRT gives a signed zero (as PCSX2).
+inline float ps2_vu_div(float fs, float ft)
+{
+    return ps2_fdiv(fs, ft);
+}
+
+inline float ps2_vu_sqrt(float ft)
+{
+    return ps2_fsqrt(ft);
+}
+
+inline float ps2_vu_rsqrt(float fs, float ft)
+{
+    const uint32_t us = std::bit_cast<uint32_t>(fs);
+    const uint32_t ut = std::bit_cast<uint32_t>(ft);
+    if ((ut & PS2_FLOAT_EXP_MASK) == 0u && (us & PS2_FLOAT_EXP_MASK) == 0u)
+        return std::bit_cast<float>((us ^ ut) & PS2_FLOAT_SIGN_MASK);
+    return ps2_frsqrt(fs, ft);
+}
+
+// CVT.W.S on the R5900 always truncates (there is no rounding mode for it; GCC uses it for (int)f) and saturates
+// when the magnitude does not fit, including exponent 255.
+inline int32_t ps2_fcvt_w(float a)
+{
+    const uint32_t u = std::bit_cast<uint32_t>(a);
+    if ((u & PS2_FLOAT_EXP_MASK) <= 0x4E800000u)
+        return static_cast<int32_t>(a);
+    return (u & PS2_FLOAT_SIGN_MASK) ? INT32_MIN : INT32_MAX;
+}
