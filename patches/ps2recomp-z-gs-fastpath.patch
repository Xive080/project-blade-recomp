+    p.fpsm = ctx.frame.psm;
+    p.zbp = GSInternal::framePageBaseToBlock(ctx.zbuf.zbp);
+    p.zpsm = ctx.zbuf.psm;
+    p.test = ctx.test;
+    p.alphaReg = ctx.alpha;
