+// Cuerpos en linea del interprete del VU1 que dependen de la instruccion en curso (banderas FMAC, escritura con
+// mascara, calculo de listo de un par). Estan aparte para que los microprogramas compilados (ps2_vu1_gen.cpp), con la
+// instruccion como constante, los resuelvan en tiempo de compilacion. Incluido por ps2_vu1_core.cpp,
+// ps2_vu1_upper.cpp, ps2_vu1_lower.cpp y ps2_vu1_gen.cpp.
+#ifndef PS2_VU1_FMAC_INC
+#define PS2_VU1_FMAC_INC
+
+#include <bit>
+#include <cstring>
+#include <algorithm>
+
+namespace
+{
+    constexpr uint8_t laneForComponent(uint32_t component)
+    {
+        return static_cast<uint8_t>(1u << (3u - component));
+    }
+}
+
+namespace
+{
+    // Operando sin riesgo de desbordamiento ni subdesbordamiento en sumas y productos: cero o
+    // |x| en [2^-63, 2^63].
+    inline bool fmacOperandSafe(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        return (bits & 0x7FFFFFFFu) == 0u || (exponent >= 64u && exponent <= 190u);
+    }
+
+    // Resultado normal lejos de los limites: |r| en [2^-101, 2^127).
+    inline bool fmacResultSafe(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        const uint32_t exponent = (bits >> 23) & 0xFFu;
+        return exponent >= 26u && exponent <= 253u;
+    }
+
+    inline uint32_t signOf(float value)
+    {
+        uint32_t bits = 0;
+        std::memcpy(&bits, &value, sizeof(bits));
+        return bits >> 31;
+    }
+}
+
+__attribute__((always_inline)) inline float VU1Interpreter::normalizeOperand(float value) const
+{
+    uint32_t bits = 0;
+    std::memcpy(&bits, &value, sizeof(bits));
+    const uint32_t exponent = (bits >> 23) & 0xFFu;
+    if (exponent == 0u)
+    {
+        bits &= 0x80000000u;
+    }
+    else if (exponent == 0xFFu)
+    {
+        bits = (bits & 0x80000000u) | 0x7F7FFFFFu;
+    }
+    std::memcpy(&value, &bits, sizeof(value));
+    return value;
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::applyDest(float *dst, const float *result, uint8_t dest)
+{
+    if (dest & 0x8u)
+        dst[0] = result[0];
+    if (dest & 0x4u)
+        dst[1] = result[1];
+    if (dest & 0x2u)
+        dst[2] = result[2];
+    if (dest & 0x1u)
+        dst[3] = result[3];
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::applyDestAcc(const float *result, uint8_t dest)
+{
+    applyDest(m_state.acc, result, dest);
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::applyFmacDest(float *dst, float *result, uint8_t dest)
+{
+    uint8_t laneFlags[4]{};
+    uint32_t extraSticky = 0u;
+    if (fastFmacFlags(result, dest, laneFlags, extraSticky))
+        updateFmacFlags(laneFlags, dest, extraSticky);
+    else
+    {
+        normalizeFmacResult(result, dest, laneFlags);
+        updateFmacFlags(laneFlags, dest, calculateFmacProductSticky(dest));
+    }
+    applyDest(dst, result, dest);
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::applyFmacDestAcc(float *result, uint8_t dest)
+{
+    uint8_t laneFlags[4]{};
+    uint32_t extraSticky = 0u;
+    if (fastFmacFlags(result, dest, laneFlags, extraSticky))
+        updateFmacFlags(laneFlags, dest, extraSticky);
+    else
+    {
+        normalizeFmacResult(result, dest, laneFlags);
+        updateFmacFlags(laneFlags, dest, calculateFmacProductSticky(dest));
+    }
+    applyDestAcc(result, dest);
+}
+
+__attribute__((always_inline)) inline bool VU1Interpreter::fastFmacFlags(const float *result, uint8_t dest, uint8_t laneFlags[4], uint32_t &extraSticky) const
+{
+    // Camino rapido de normalizeFmacResult + calculateFmacProductSticky. Con operandos y resultado
+    // en rango, el calculo exacto (long double) no puede dar cero, desbordamiento ni subdesbordamiento
+    // y su signo es el del resultado en float: la unica bandera es S y el valor no cambia. En otro
+    // caso se devuelve false y se usa el calculo exacto de siempre.
+    const uint32_t upper = m_currentUpperInstruction;
+    const uint8_t op = static_cast<uint8_t>(upper & 0x3Fu);
+    const uint8_t code = op >= 0x3Cu ? static_cast<uint8_t>((upper & 3u) | ((upper >> 4) & 0x7Cu)) : op;
+    const bool special = op >= 0x3Cu;
+    const float *vs = m_state.vf[FS(upper)];
+    const float *vt = m_state.vf[FT(upper)];
+
+    enum : uint8_t { SrcBc, SrcQ, SrcI, SrcVec, SrcCross } src;
+    bool usesAcc = false;
+    if (code <= 0x0Fu)
+    {
+        src = SrcBc;
+        usesAcc = code >= 0x08u;
+    }
+    else if (code >= 0x18u && code <= 0x1Bu)
+        src = SrcBc;
+    else
+    {
+        switch (code)
+        {
+        case 0x1Cu: case 0x20u: case 0x24u: src = SrcQ; break;
+        case 0x21u: case 0x25u: src = SrcQ; usesAcc = true; break;
+        case 0x1Eu: case 0x22u: case 0x26u: src = SrcI; break;
+        case 0x23u: case 0x27u: src = SrcI; usesAcc = true; break;
+        case 0x28u: case 0x2Au: case 0x2Cu: src = SrcVec; break;
+        case 0x29u: case 0x2Du: src = SrcVec; usesAcc = true; break;
+        case 0x2Eu: src = SrcCross; usesAcc = !special; break;
+        default: return false;
+        }
+    }
+
+    static constexpr uint8_t crossLeft[4] = {1u, 2u, 0u, 3u};
+    static constexpr uint8_t crossRight[4] = {2u, 0u, 1u, 3u};
+    uint8_t flags[4] = {0u, 0u, 0u, 0u};
+    uint32_t sticky = 0u;
+    for (uint32_t component = 0; component < 4u; ++component)
+    {
+        if ((dest & laneForComponent(component)) == 0u)
+            continue;
+        float a = 0.0f;
+        float b = 0.0f;
+        switch (src)
+        {
+        case SrcBc: a = vs[component]; b = vt[code & 3u]; break;
+        case SrcQ: a = vs[component]; b = m_state.q; break;
+        case SrcI: a = vs[component]; b = m_state.i; break;
+        case SrcVec: a = vs[component]; b = vt[component]; break;
+        case SrcCross:
+            if (component == 3u)
+                return false;
+            a = vs[crossLeft[component]];
+            b = vt[crossRight[component]];
+            break;
+        }
+        a = normalizeOperand(a);
+        b = normalizeOperand(b);
+        if (!fmacOperandSafe(a) || !fmacOperandSafe(b))
+            return false;
+        uint32_t resultBits = 0;
+        std::memcpy(&resultBits, &result[component], sizeof(resultBits));
+        const bool zeroResult = (resultBits & 0x7FFFFFFFu) == 0u;
+        if (!zeroResult && !fmacResultSafe(result[component]))
+            return false;
+        if (usesAcc)
+        {
+            if (!fmacOperandSafe(normalizeOperand(m_state.acc[component])))
+                return false;
+            // Resultado cero en MADD/MSUB: solo es seguro si el producto en float es exacto (entonces el
+            // calculo exacto tambien da cero, con el mismo signo).
+            if (zeroResult && static_cast<double>(a * b) != static_cast<double>(a) * static_cast<double>(b))
+                return false;
+            // Banderas del producto (pegajosas): Z si algun factor es cero, S por el signo.
+            if ((a == 0.0f) || (b == 0.0f))
+                sticky |= 0x1u;
+            if ((signOf(a) ^ signOf(b)) != 0u)
+                sticky |= 0x2u;
+        }
+        // Cero: sumas, restas y productos de operandos en rango solo dan cero si el resultado exacto es
+        // cero, con el mismo signo (mismo modo de redondeo): banderas Z y S como en el calculo exacto.
+        flags[component] = static_cast<uint8_t>((signOf(result[component]) != 0u ? 0x2u : 0x0u) | (zeroResult ? 0x1u : 0x0u));
+    }
+    std::memcpy(laneFlags, flags, sizeof(flags));
+    extraSticky = sticky;
+    return true;
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::updateFmacFlags(const uint8_t laneFlags[4], uint8_t dest,
+                                     uint32_t extraSticky)
+{
+    if (dest == 0u)
+        return;
+
+    uint32_t mac = 0u;
+    uint32_t status = 0u;
+    for (uint32_t component = 0; component < 4u; ++component)
+    {
+        const uint8_t lane = laneForComponent(component);
+        if ((dest & lane) == 0u)
+            continue;
+
+        const uint32_t flags = laneFlags[component];
+        if ((flags & 0x1u) != 0u)
+            mac |= lane;
+        if ((flags & 0x2u) != 0u)
+            mac |= static_cast<uint32_t>(lane) << 4;
+        if ((flags & 0x4u) != 0u)
+            mac |= static_cast<uint32_t>(lane) << 8;
+        if ((flags & 0x8u) != 0u)
+            mac |= static_cast<uint32_t>(lane) << 12;
+        status |= flags;
+    }
+
+    // m_flagMask refleja exactamente las entradas validas: el primer hueco libre es su primer bit a 0
+    // (el mismo que encontraba el recorrido lineal).
+    const uint32_t freeIndex = static_cast<uint32_t>(std::countr_zero(~m_flagMask));
+    if (freeIndex >= kMaxFlagEntries)
+    {
+        reportReservedInstruction(true, 0xFFFFFFFFu);
+        return;
+    }
+
+    FlagPipelineEntry *entry = &m_flagPipeline[freeIndex];
+    *entry = {};
+    entry->valid = true;
+    m_flagMask |= 1u << freeIndex;
+    entry->issueCycle = m_cycle;
+    entry->readyCycle = m_cycle + kFmacLatency;
+    entry->mac = mac;
+    entry->status = status;
+    entry->extraSticky = extraSticky;
+    entry->writesMac = true;
+    entry->writesStatus = true;
+}
+
+__attribute__((always_inline)) inline uint64_t VU1Interpreter::calculatePairReadyCycle(const DecodedInstructionPair &decoded) const
+{
+    // Lecturas precalculadas al decodificar (componentes de VF, bits de VI y de ACC de las dos mitades).
+    uint64_t ready = m_cycle;
+    for (uint32_t index = 0; index < decoded.vfReadSlotCount; ++index)
+        ready = std::max(ready, m_vfReady[decoded.vfReadSlots[index] >> 2][decoded.vfReadSlots[index] & 3u]);
+    for (uint32_t bits = decoded.viReadBits; bits != 0u; bits &= bits - 1u)
+        ready = std::max(ready, m_viReady[static_cast<uint32_t>(std::countr_zero(bits))]);
+    for (uint32_t component = 0; component < 4u; ++component)
+    {
+        if ((decoded.accReadLanes & laneForComponent(component)) != 0u)
+            ready = std::max(ready, m_accReady[component]);
+    }
+
+    if (decoded.lowerUsage.pipeline == PipelineFdiv && m_fdiv.valid)
+        ready = std::max(ready, m_fdiv.readyCycle);
+    if (decoded.lowerUsage.pipeline == PipelineEfu)
+        ready = std::max(ready, m_efuResourceReady);
+    if (decoded.lowerUsage.waitQ && m_fdiv.valid)
+        ready = std::max(ready, m_fdiv.readyCycle);
+    if (decoded.lowerUsage.waitP)
+    {
+        for (const ScalarPipelineEntry &entry : m_efu)
+            if (entry.valid)
+                ready = std::max(ready, entry.readyCycle);
+    }
+    if (decoded.lowerUsage.pipeline == PipelineXgkick && m_xgkick.active)
+        ready = std::max(ready, m_cycle + 1u);
+    return ready;
+}
+
+__attribute__((always_inline)) inline void VU1Interpreter::markPairWrites(const DecodedInstructionPair &decoded)
+{
+    const VfAccess lowerWrite = decoded.lowerUsage.vfWrite;
+    if (lowerWrite.reg != 0u &&
+        decoded.suppressedLowerVf != lowerWrite.reg)
+    {
+        const uint32_t latency = decoded.lowerUsage.vfLatency != 0u
+                                     ? decoded.lowerUsage.vfLatency
+                                     : decoded.lowerUsage.latency;
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            if ((lowerWrite.lanes & laneForComponent(component)) != 0u)
+                m_vfReady[lowerWrite.reg][component] = m_cycle + latency;
+        }
+    }
+
+    const VfAccess upperWrite = decoded.upperUsage.vfWrite;
+    if (upperWrite.reg != 0u)
+    {
+        const uint32_t latency = decoded.upperUsage.vfLatency != 0u
+                                     ? decoded.upperUsage.vfLatency
+                                     : decoded.upperUsage.latency;
+        for (uint32_t component = 0; component < 4u; ++component)
+        {
+            if ((upperWrite.lanes & laneForComponent(component)) != 0u)
+                m_vfReady[upperWrite.reg][component] = m_cycle + latency;
+        }
+    }
+
+    for (uint32_t bits = decoded.lowerUsage.viWrite & 0xFFFEu; bits != 0u; bits &= bits - 1u)
+        m_viReady[static_cast<uint32_t>(std::countr_zero(bits))] = m_cycle + (decoded.lowerUsage.viLatency != 0u ? decoded.lowerUsage.viLatency : decoded.lowerUsage.latency);
+    for (uint32_t component = 0; component < 4u; ++component)
+    {
+        if ((decoded.upperUsage.accWrite & laneForComponent(component)) != 0u)
+            m_accReady[component] = m_cycle + kAccForwardLatency;
+    }
+}
+
+#endif
