+    // Simulacion del reparto en tramos con la prueba exacta (misma estructura que SubmitManyImpl)
+    void g0Simulate(const GSPrimitiveBatch *const *batches, size_t count)
+    {
+        static thread_local G0Info info;
+        static thread_local G0Blocks wset, rset;
+        uint64_t par = 0, ser = 0, parPx = 0, serPx = 0, runs = 0;
+        size_t i = 0;
+        while (i < count)
+        {
+            const GSPrimitiveBatch &first = *batches[i];
+            if (first.vertexCount == 0u) { ++i; continue; }
+            const bool zUsed = zbufferUsed(first.state.context);
+            int y1 = primMaxRow(first);
+            const bool targetOk = !rangesOverlap(targetRange(first.state.context.frame.fbp, first.state.context.frame.fbw, first.state.context.frame.psm, y1),
+                                                 zUsed ? targetRange(first.state.context.zbuf.zbp, first.state.context.frame.fbw, first.state.context.zbuf.psm, y1) : PageRange{});
+            size_t j = i;
+            uint64_t pixels = 0, nprim = 0;
+            if (targetOk)
+            {
+                wset.reset(); rset.reset();
+                while (j < count)
+                {
+                    const GSPrimitiveBatch &b = *batches[j];
+                    if (b.vertexCount == 0u) { ++j; continue; }
+                    if (!sameTarget(first.state, b.state)) break;
+                    g0Compute(b, info);
+                    const G0Blocks w = info.frame | info.z;
+                    if ((info.read & (wset | w)).any() || (w & rset).any())
+                        break;
+                    wset |= w; rset |= info.read;
+                    pixels += approximatePixels(b);
+                    ++nprim;
+                    ++j;
+                }
+            }
+            if (j - i >= 1u && pixels >= 4096u) { par += nprim; parPx += pixels; ++runs; i = j; continue; }
+            const size_t end = (j > i) ? j : i + 1u;
+            for (; i < end; ++i)
+                if (batches[i]->vertexCount != 0u) { ++ser; serPx += approximatePixels(*batches[i]); }
+        }
+        std::lock_guard<std::mutex> lk(g_g0s.mu);
+        g_g0s.simPar += par; g_g0s.simSer += ser; g_g0s.simParPx += parPx; g_g0s.simSerPx += serPx; g_g0s.simRuns += runs;
+        g_g0s.totPrims += par + ser;
+    }
+
