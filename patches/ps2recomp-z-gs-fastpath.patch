+    p.abe = state.prim.abe;
+    p.pabe = state.pabe;
+    p.zmask = ctx.zbuf.zmask;
+    p.bpp16 = bitsPerPixel(static_cast<uint8_t>(p.fpsm)) == 16;
+    p.ct24 = p.fpsm == GS_PSM_CT24;
+    p.ct32 = p.fpsm == GS_PSM_CT32;
+    p.dateOn = ((ctx.test >> 14) & 0x1u) != 0u && (p.fpsm == GS_PSM_CT32 || p.fpsm == GS_PSM_CT16 || p.fpsm == GS_PSM_CT16S);
+    p.ztestMethod = static_cast<uint32_t>((ctx.test >> 17) & 3u);
+    p.fbmsk = ctx.frame.fbmsk;
+    p.asel = ctx.alpha & 3;
+    p.bsel = (ctx.alpha >> 2) & 3;
+    p.csel = (ctx.alpha >> 4) & 3;
+    p.dsel = (ctx.alpha >> 6) & 3;
+    p.fix = static_cast<uint8_t>((ctx.alpha >> 32) & 0xFF);
+    p.fbFmt = pxFmtOf(p.fpsm);
+    p.zFmt = pxFmtOf(p.zpsm);
+    p.fbRead = m_readVramFuncs[p.fpsm & 0x3Fu];
+    p.zRead = m_readVramFuncs[p.zpsm & 0x3Fu];
+    p.fbWrite = m_writeVramFuncs[p.fpsm & 0x3Fu];
+    p.zWrite = m_writeVramFuncs[p.zpsm & 0x3Fu];
+    p.vram = m_vram;
+}
+
+bool GSCpuBackend::EarlyDepthFast(const GSPixelPipe &p, int x, int y, uint32_t z) const
+{
+    if (x < p.sx0 || x > p.sx1 || y < p.sy0 || y > p.sy1)
+        return false;
+    switch (p.ztestMethod)
+    {
+    case 0:
+        return false;
+    case 1:
+        return true;
+    case 2:
+        return z >= pxRead(p.zFmt, p.vram, p.zbp, p.fbw, x, y, p.zRead);
+    default:
+        return z > pxRead(p.zFmt, p.vram, p.zbp, p.fbw, x, y, p.zRead);
+    }
+}
+
+void GSCpuBackend::WritePixelFast(const GSPixelPipe &p, int x, int y, int z, uint8_t r, uint8_t g, uint8_t b, uint8_t a, uint8_t fog) const
+{
+    if (x < p.sx0 || x > p.sx1 || y < p.sy0 || y > p.sy1)
+        return;
+
+    if (p.fge)
+    {
+        const uint32_t inverseFog = 255u - fog;
+        auto applyFog = [&](uint8_t input, uint8_t fogColor) -> uint8_t
+        {
+            return static_cast<uint8_t>(((static_cast<uint32_t>(fog) * input) >> 8) + ((inverseFog * fogColor) >> 8));
+        };
+        r = applyFog(r, p.fogR);
+        g = applyFog(g, p.fogG);
+        b = applyFog(b, p.fogB);
+    }
+
+    PixelWriteMask writeMask{};
+    if (p.ateOn)
+        writeMask = classifyAlphaTest(p.test, a, static_cast<uint8_t>(p.fpsm));
+    if (!writeMask.writesAnything())
+        return;
+
+    const bool preserveDestinationAlpha = writeMask.writeRgb && !writeMask.writeAlpha && p.ct32;
+    const bool frmw = p.dateOn || (writeMask.writesFramebuffer() && ((p.fbmsk != 0) || p.abe || preserveDestinationAlpha));
+
+    uint32_t rawFramebufferPixel = 0;
+    uint32_t fbrgba = 0;
+    if (frmw)
+    {
+        rawFramebufferPixel = pxRead(p.fbFmt, p.vram, p.fbp, p.fbw, x, y, p.fbRead);
+        fbrgba = rawFramebufferPixel;
+        if (p.bpp16)
+            fbrgba = Rgba5551ToRgba8888(fbrgba);
+        else if (p.ct24)
+            fbrgba |= 0x80000000u;
+    }
+
+    if (!passesDestinationAlphaTest(p.test, static_cast<uint8_t>(p.fpsm), rawFramebufferPixel))
+        return;
+
+    bool zpass = false;
+    switch (p.ztestMethod)
+    {
+    case 0:
+        zpass = false;
+        break;
+    case 1:
+        zpass = true;
+        break;
+    case 2:
+        zpass = static_cast<uint32_t>(z) >= pxRead(p.zFmt, p.vram, p.zbp, p.fbw, x, y, p.zRead);
+        break;
+    case 3:
+        zpass = static_cast<uint32_t>(z) > pxRead(p.zFmt, p.vram, p.zbp, p.fbw, x, y, p.zRead);
+        break;
+    }
+    if (!zpass)
+        return;
+
+    if (writeMask.writesFramebuffer())
+    {
+        const uint8_t srcR = r, srcG = g, srcB = b;
+        if (p.abe)
+        {
+            uint8_t dr = fbrgba & 0xFF;
+            uint8_t dg = (fbrgba >> 8) & 0xFF;
+            uint8_t db = (fbrgba >> 16) & 0xFF;
+            uint8_t da = (fbrgba >> 24) & 0xFF;
+            if (!(p.pabe && (a & 0x80u) == 0u))
+            {
+                auto pickRGB = [&](uint8_t sel, int cs, int cd) -> int
+                {
+                    if (sel == 0)
+                        return cs;
+                    if (sel == 1)
+                        return cd;
+                    return 0;
+                };
+                int cAlpha = (p.csel == 0) ? a : (p.csel == 1) ? da : p.fix;
+                r = clampU8(((pickRGB(p.asel, r, dr) - pickRGB(p.bsel, r, dr)) * cAlpha >> 7) + pickRGB(p.dsel, r, dr));
+                g = clampU8(((pickRGB(p.asel, g, dg) - pickRGB(p.bsel, g, dg)) * cAlpha >> 7) + pickRGB(p.dsel, g, dg));
+                b = clampU8(((pickRGB(p.asel, b, db) - pickRGB(p.bsel, b, db)) * cAlpha >> 7) + pickRGB(p.dsel, b, db));
+            }
+            else
+            {
+                r = srcR;
+                g = srcG;
+                b = srcB;
+            }
+        }
+
+        if (writeMask.writeAlpha && (p.fba & 0x1ull) != 0ull && !p.ct24)
+            a = static_cast<uint8_t>(a | 0x80u);
+
+        uint32_t pixel = pack32(r, g, b, a);
+        if (p.fbmsk != 0)
+            pixel = (pixel & ~p.fbmsk) | (fbrgba & p.fbmsk);
+        if (preserveDestinationAlpha)
+            pixel = (pixel & 0x00FFFFFFu) | (fbrgba & 0xFF000000u);
+        if (p.bpp16)
+            pixel = Rgba8888ToRgba5551(pixel);
+
+        pxWrite(p.fbFmt, p.vram, p.fbp, p.fbw, x, y, pixel, p.fbWrite);
+    }
+
+    if (writeMask.writeDepth && !p.zmask)
+        pxWrite(p.zFmt, p.vram, p.zbp, p.fbw, x, y, static_cast<uint32_t>(z), p.zWrite);
+}
+
+// Entradas publicas: A/B (PS2X_GS_AB=1) y perfil (PS2X_GS_PROFILE=1)
+template <typename F>
+void GSCpuBackend::RunWithAB(const char *what, F &&run)
+{
+    if (!g_gsAB || g_gsLegacy.load(std::memory_order_relaxed))
+    {
+        run();
+        return;
+    }
+    static std::vector<uint8_t> saved, fastResult;
+    static uint64_t calls = 0, checked = 0;
+    const size_t n = m_vram ? GSMem::MEMORY_SIZE : 0u;
+    if (!n)
+    {
+        run();
+        return;
+    }
+    saved.assign(m_vram, m_vram + n);
+    run(); // ruta rapida
+    fastResult.assign(m_vram, m_vram + n);
+    std::memcpy(m_vram, saved.data(), n);
+    g_gsLegacy.store(true, std::memory_order_relaxed);
+    g_gsForceSerial.store(true, std::memory_order_relaxed); // referencia: todo en orden en un solo hilo
+    run(); // ruta antigua
+    g_gsForceSerial.store(false, std::memory_order_relaxed);
+    g_gsLegacy.store(false, std::memory_order_relaxed);
+    ++calls;
+    ++checked;
+    if (std::memcmp(m_vram, fastResult.data(), n) != 0)
+    {
+        size_t first = 0, count = 0;
+        for (size_t i = 0; i < n; ++i)
+            if (m_vram[i] != fastResult[i])
+            {
+                if (count == 0)
+                    first = i;
+                ++count;
+            }
+        std::fprintf(stderr, "GS_AB DIFERENCIA en %s (llamada %llu): %zu bytes distintos, primero en 0x%zx (antigua=%02x rapida=%02x)\n",
+                     what, static_cast<unsigned long long>(calls), count, first, m_vram[first], fastResult[first]);
+        std::fflush(stderr);
+        std::abort();
+    }
+    if ((checked % 2000u) == 0u)
+    {
+        std::fprintf(stderr, "GS_AB ok: %llu tramos comparados\n", static_cast<unsigned long long>(checked));
+        std::fflush(stderr);
+    }
+}
