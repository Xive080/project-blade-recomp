+// DMA canal 4 (memoria -> IPU). Se completa en el acto: recorre la cadena de tags (o el bloque
+// MADR/QWC en modo normal), deja MADR/TADR/QWC/CHCR como los dejaria el DMAC al acabar
+// (las rutinas tipo vibuf calculan lo consumido con D4_MADR) y entrega los bytes al HLE de sceMpeg.
+void PS2Memory::processIpuToDma(uint32_t chcr)
+{
+    static constexpr uint32_t kBase = 0x1000B400u;
+    static constexpr uint32_t kDStat = 0x1000E010u;
+    static constexpr uint32_t kIpuToChannel = 4u;
+    static constexpr int kMaxChainTags = 4096;
+
+    uint32_t madr = m_ioRegisters[kBase + 0x10u];
+    uint32_t qwc = m_ioRegisters[kBase + 0x20u] & 0xFFFFu;
+    uint32_t tadr = m_ioRegisters[kBase + 0x30u];
+    uint32_t asr0 = m_ioRegisters[kBase + 0x40u];
+    uint32_t asr1 = m_ioRegisters[kBase + 0x50u];
+    uint32_t asp = (chcr >> 4) & 0x3u;
+    const uint32_t mode = (chcr >> 2) & 0x3u;
+    const bool tieEnabled = (chcr & (1u << 7)) != 0u;
+    uint32_t tagUpper = (chcr >> 16) & 0xFFFFu;
+
+    std::vector<uint8_t> data;
+    auto append = [&](uint32_t srcAddr, uint32_t qwCount)
+    {
+        const bool spr = (srcAddr & 0x80000000u) != 0u || isScratchpad(srcAddr);
+        const uint8_t *base = spr ? m_scratchpad : m_rdram;
+        const uint32_t size = spr ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        uint32_t src = spr ? (srcAddr & (PS2_SCRATCHPAD_SIZE - 1u)) : (translateAddress(srcAddr & 0x7FFFFFFFu) & PS2_RAM_MASK);
+        uint64_t bytes = static_cast<uint64_t>(qwCount) * 16u;
+        while (bytes > 0u && base != nullptr)
+        {
+            if (src >= size)
+                src = 0u;
+            const uint32_t chunk = static_cast<uint32_t>(std::min<uint64_t>(bytes, size - src));
+            data.insert(data.end(), base + src, base + src + chunk);
+            bytes -= chunk;
+            src += chunk;
+        }
+    };
+
+    // Resto de una transferencia parada a medias (QWC > 0).
+    bool endChain = (mode != 1u);
+    if (qwc > 0u)
+    {
+        append(madr, qwc);
+        madr += qwc * 16u;
+        qwc = 0u;
+        const uint32_t id = (tagUpper >> 12) & 0x7u;
+        if (id == 0u || id == 7u || (tieEnabled && (tagUpper & 0x8000u) != 0u))
+            endChain = true;
+    }
+
+    int tags = 0;
+    while (!endChain && tags < kMaxChainTags)
+    {
+        const bool tagSpr = (tadr & 0x80000000u) != 0u || isScratchpad(tadr);
+        const uint8_t *tagBase = tagSpr ? m_scratchpad : m_rdram;
+        const uint32_t tagSize = tagSpr ? PS2_SCRATCHPAD_SIZE : PS2_RAM_SIZE;
+        const uint32_t tagPhys = tagSpr ? (tadr & (PS2_SCRATCHPAD_SIZE - 1u)) : (translateAddress(tadr & 0x7FFFFFFFu) & PS2_RAM_MASK);
+        if (tagBase == nullptr || tagPhys + 16u > tagSize)
+            break;
+        uint64_t tag = 0;
+        std::memcpy(&tag, tagBase + tagPhys, sizeof(tag));
+        ++tags;
+
+        const uint32_t tagQwc = static_cast<uint32_t>(tag & 0xFFFFu);
+        const uint32_t id = static_cast<uint32_t>((tag >> 28) & 0x7u);
+        const bool irq = ((tag >> 31) & 0x1u) != 0u;
+        const uint32_t addr = static_cast<uint32_t>((tag >> 32) & 0x7FFFFFF0u);
+        tagUpper = static_cast<uint32_t>((tag >> 16) & 0xFFFFu);
+
+        uint32_t dataAddr = 0u;
+        switch (id)
+        {
+        case 0: // refe
+            dataAddr = addr;
+            tadr += 16u;
+            endChain = true;
+            break;
+        case 1: // cnt
+            dataAddr = tadr + 16u;
+            tadr = dataAddr + tagQwc * 16u;
+            break;
+        case 2: // next
+            dataAddr = tadr + 16u;
+            tadr = addr;
+            break;
+        case 3: // ref
+        case 4: // refs
+            dataAddr = addr;
+            tadr += 16u;
+            break;
+        case 5: // call
+            dataAddr = tadr + 16u;
+            if (asp == 0u)
+                asr0 = dataAddr + tagQwc * 16u;
+            else
+                asr1 = dataAddr + tagQwc * 16u;
+            asp = std::min<uint32_t>(asp + 1u, 2u);
+            tadr = addr;
+            break;
+        case 6: // ret
+            dataAddr = tadr + 16u;
+            if (asp == 2u)
+            {
+                tadr = asr1;
+                asp = 1u;
+            }
+            else if (asp == 1u)
+            {
+                tadr = asr0;
+                asp = 0u;
+            }
+            else
+            {
+                endChain = true;
+            }
+            break;
+        default: // end
+            dataAddr = tadr + 16u;
+            endChain = true;
+            break;
+        }
+
+        if (tagQwc > 0u)
+            append(dataAddr, tagQwc);
+        madr = dataAddr + tagQwc * 16u;
+        if (irq && tieEnabled)
+            endChain = true;
+    }
+
+    m_ioRegisters[kBase + 0x10u] = madr;
+    m_ioRegisters[kBase + 0x20u] = 0u;
+    m_ioRegisters[kBase + 0x30u] = tadr;
+    m_ioRegisters[kBase + 0x40u] = asr0;
+    m_ioRegisters[kBase + 0x50u] = asr1;
+    uint32_t doneChcr = (chcr & 0x0000FFCFu & ~0x100u) | ((asp & 0x3u) << 4);
+    if (mode == 1u)
+        doneChcr |= tagUpper << 16;
+    m_ioRegisters[kBase] = doneChcr;
+
+    uint32_t dstat = m_ioRegisters.count(kDStat) ? m_ioRegisters[kDStat] : 0u;
+    dstat |= (1u << kIpuToChannel);
+    if (((dstat & 0x3FFu) & ((dstat >> 16) & 0x3FFu)) != 0u)
+        dstat |= (1u << 31);
+    m_ioRegisters[kDStat] = dstat;
+    queueCompletedDmacCause(kIpuToChannel);
+
+    static uint32_t s_ipuDmaLogCount = 0u;
+    if (s_ipuDmaLogCount < 16u)
+    {
+        ++s_ipuDmaLogCount;
+        PS2_IF_AGRESSIVE_LOGS({
+            std::cerr << "[IPU:toDMA] chcr=0x" << std::hex << chcr << " madr=0x" << madr << " tadr=0x" << tadr
+                      << std::dec << " tags=" << tags << " bytes=" << data.size() << std::endl;
+        });
+    }
+
+    if (data.empty())
+        return;
+    std::lock_guard<std::mutex> lock(m_ipuInputMutex);
+    if (!m_ipuInputCapture)
+        return;
+    constexpr size_t kMaxIpuInputBytes = 32u * 1024u * 1024u;
+    if (m_ipuInput.size() + data.size() > kMaxIpuInputBytes)
+        m_ipuInput.clear();
+    m_ipuInput.insert(m_ipuInput.end(), data.begin(), data.end());
+}
+
